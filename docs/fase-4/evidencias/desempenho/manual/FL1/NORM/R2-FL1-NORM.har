\":false}},\"progressKey\":\"p5025944629936128\",\"slug\":\"css-selecting-by-class\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"CSS: Seleção por classe\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/intro-to-css/pt/css-selecting-by-class\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/intro-to-css/pc/challenge-apples-and-bananas-classes\",\"contentDescriptor\":\"Challenge:xa3120f70707da7d6\",\"contentKind\":\"Challenge\",\"id\":\"xa3120f70707da7d6\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xae5108e8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4670903452696576\",\"slug\":\"challenge-apples-and-bananas-classes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Classes de maçãs e bananas\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/intro-to-css/pc/challenge-apples-and-bananas-classes\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/html-css/intro-to-css/e/quiz--simple-css-selectors\",\"contentDescriptor\":\"Exercise:x23a2cc94\",\"contentKind\":\"Exercise\",\"exerciseLength\":4,\"id\":\"x23a2cc94\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xae5108e8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ex23a2cc94\",\"slug\":\"quiz--simple-css-selectors\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":4,\"upperBound\":6},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"O quanto você conhece os seletores id, elementos, e classes? Descubra!\",\"translatedTitle\":\"Usando seletores CSS simples\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/intro-to-css/e/quiz--simple-css-selectors\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/html-css/intro-to-css/pp/project-travel-webpage\",\"contentDescriptor\":\"Project:x0d1cdc24913dc0e3\",\"contentKind\":\"Project\",\"id\":\"x0d1cdc24913dc0e3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xae5108e8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5255589914738688\",\"slug\":\"project-travel-webpage\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eNesse projeto, você vai usar tudo o que aprendeu até agora para criar um site de viagens incentivando as pessoas a visitar um lugar exótico. Você deve ter imagens do que elas vão ver, listas de coisas para ver e lugares para ir e parágrafos de detalhes interessantes. Você também deve usar CSS para estilizar o site, usando uma mistura de seletores simples que você aprendeu.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eDica: você não consegue encontrar as imagens que você quer em nosso seletor de imagens? Você também pode usar imagens da Wikipedia. Para isso, faça uma \\u003ca href=\\\"https://www.google.com/search?site=\\u0026amp;tbm=isch\\u0026amp;source=hp\\u0026amp;biw=1439\\u0026amp;bih=778\\u0026amp;q=site%3Awikipedia.org+\\u0026amp;oq=site%3Awikipedia.org+\\u0026amp;gs_l=img.3...437.4670.0.4871.33.7.2.24.0.0.135.615.6j1.7.0....0...1ac.1.64.img..27.6.459.QLGFMUmn4qs#tbm=isch\\u0026amp;q=site:wikipedia.org+pineapple\\\"\\u003ebusca restrita em sites no Google\\u003c/a\\u003e, então clique em  \\u0026quot;View image\\u0026quot;Visualizar imagem\\u0026quot; no resultado que você quiser e copie a URL em sua \\u003ccode\\u003e\\u0026lt;img\\u0026gt;\\u003c/code\\u003e  tag.\\u003c/p\\u003e\\u003e\\n\",\"translatedTitle\":\"Projeto: página web sobre viagens\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/intro-to-css/pp/project-travel-webpage\",\"userAuthoredContentType\":\"webpage\"}],\"id\":\"xae5108e8\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhhZTUxMDhlOAw\",\"relativeUrl\":\"/computing/computer-programming/html-css/intro-to-css\",\"slug\":\"intro-to-css\",\"translatedDescription\":\"Aprenda a escrever regras CSS simples, para selecionar com base no elemento, classe, ou ID, e para alterar as cores da sua página.\",\"translatedTitle\":\"Introdução a CSS\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-tags-continued/pt/html-links\",\"contentDescriptor\":\"Talkthrough:xed2558436ff0de51\",\"contentKind\":\"Talkthrough\",\"id\":\"xed2558436ff0de51\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x93850788\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5306658357248000\",\"slug\":\"html-links\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Links HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-tags-continued/pt/html-links\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-tags-continued/pt/html-internal-links\",\"contentDescriptor\":\"Talkthrough:xe33025bad127bfa3\",\"contentKind\":\"Talkthrough\",\"id\":\"xe33025bad127bfa3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x93850788\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4820183568089088\",\"slug\":\"html-internal-links\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Links internos HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-tags-continued/pt/html-internal-links\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-tags-continued/pc/challenge-jump-around\",\"contentDescriptor\":\"Challenge:x712ae29530655756\",\"contentKind\":\"Challenge\",\"id\":\"x712ae29530655756\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x93850788\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5298232533188608\",\"slug\":\"challenge-jump-around\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Pular\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-tags-continued/pc/challenge-jump-around\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-tags-continued/pt/html-tables\",\"contentDescriptor\":\"Talkthrough:x04b7cfdb59f74e2d\",\"contentKind\":\"Talkthrough\",\"id\":\"x04b7cfdb59f74e2d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x93850788\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6263345914314752\",\"slug\":\"html-tables\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Tabelas HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-tags-continued/pt/html-tables\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-tags-continued/pt/html-comments\",\"contentDescriptor\":\"Talkthrough:x6cd64bf2fdab2cf2\",\"contentKind\":\"Talkthrough\",\"id\":\"x6cd64bf2fdab2cf2\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x93850788\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4923263135514624\",\"slug\":\"html-comments\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Comentários HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-tags-continued/pt/html-comments\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-tags-continued/pp/project-recipe-book\",\"contentDescriptor\":\"Project:x6f4cbd00fb5e20e0\",\"contentKind\":\"Project\",\"id\":\"x6f4cbd00fb5e20e0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x93850788\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5710844586622976\",\"slug\":\"project-recipe-book\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eCrie uma página web com suas receitas favoritas! O livro de receitas deve ter uma tabela de conteúdos com links para cada receita abaixo, usando links internos. Cada receita deve ter uma tabela com os ingredientes, uma lista de detalhes, e uma lista e/ou parágrafos dos passos necessários. Se você usar receitas da internet, lembre-se de adicionar um link para o site.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eUse CSS para estilizar o livro de receitas, usando uma mistura de seletores simples e cores que você aprendeu.\\u0026#39;ve learned.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eDica: não consegue encontrar as imagens que você quer em nosso seletor de imagens? Você também pode usar imagens da Wikipedia. Para isso, faça uma a\\u0026nbsp;\\u003ca href=\\\"http://www.google.com/search?site=\\u0026amp;tbm=isch\\u0026amp;source=hp\\u0026amp;biw=1439\\u0026amp;bih=778\\u0026amp;q=site%3Awikipedia.org+\\u0026amp;oq=site%3Awikipedia.org+\\u0026amp;gs_l=img.3...437.4670.0.4871.33.7.2.24.0.0.135.615.6j1.7.0....0...1ac.1.64.img..27.6.459.QLGFMUmn4qs#tbm=isch\\u0026amp;q=site:wikipedia.org+pineapple\\\"\\u003e,busca restrita em sites no Google\\u003c/a\\u003e, então clique em \\u0026quot;View image\\u0026quot; no resultado que você quiser e copie a URL em sua tag \\u0026nbsp;\\u0026lt;img\\u0026gt;\\u0026nbsp;tag.\\u003c/p\\u003e\\n\",\"translatedTitle\":\"Projeto: livro de receitas\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-tags-continued/pp/project-recipe-book\",\"userAuthoredContentType\":\"webpage\"}],\"id\":\"x93850788\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg5Mzg1MDc4OAw\",\"relativeUrl\":\"/computing/computer-programming/html-css/html-tags-continued\",\"slug\":\"html-tags-continued\",\"translatedDescription\":\"Aprenda a criar links, tabelas e comentários.\",\"translatedTitle\":\"Mais tags HTML\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-text-properties/v/css-zen-garden\",\"contentDescriptor\":\"Video:x20d5d0eb\",\"contentKind\":\"Video\",\"id\":\"x20d5d0eb\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x10c7b82a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"vx20d5d0eb\",\"slug\":\"css-zen-garden\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"CSS (Cascading Style Sheets) pode alterar dramaticamente a aparência de um site, mesmo quando o HTML permanece o mesmo. Podemos nos inspirar no site CSS Zen Garden! Muitos programadores diferentes usam CSS Zen Garden para mostrar seus designs no mesmo site HTML, apenas usando um outro CSS. Os sites resultantes são muito diferentes!\",\"translatedTitle\":\"CSS Zen Garden\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-text-properties/v/css-zen-garden\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-text-properties/pt/css-font-family-property\",\"contentDescriptor\":\"Talkthrough:x940af4745d7f9546\",\"contentKind\":\"Talkthrough\",\"id\":\"x940af4745d7f9546\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x10c7b82a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6314802575310848\",\"slug\":\"css-font-family-property\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Propriedade CSS font-family\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-text-properties/pt/css-font-family-property\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-text-properties/pt/css-font-size-property\",\"contentDescriptor\":\"Talkthrough:xef4b8b505c3edef4\",\"contentKind\":\"Talkthrough\",\"id\":\"xef4b8b505c3edef4\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x10c7b82a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6408073213378560\",\"slug\":\"css-font-size-property\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Propriedade CSS font-size\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-text-properties/pt/css-font-size-property\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-text-properties/pc/challenge-great-big-font-sizes\",\"contentDescriptor\":\"Challenge:xdd46017333ab3f76\",\"contentKind\":\"Challenge\",\"id\":\"xdd46017333ab3f76\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x10c7b82a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6362220301910016\",\"slug\":\"challenge-great-big-font-sizes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Tamanhos de fonte enormes\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-text-properties/pc/challenge-great-big-font-sizes\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-text-properties/pt/css-font-styles-and-shorthand\",\"contentDescriptor\":\"Talkthrough:xec025257755fe9ef\",\"contentKind\":\"Talkthrough\",\"id\":\"xec025257755fe9ef\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x10c7b82a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progres