            "mimeType": "application/json",
            "text": "{\"data\":{\"content\":{\"__typename\":\"Content\",\"metadata\":{\"__typename\":\"ContentMetadata\",\"commitSha\":\"5b7b055783743c03924e856a27d6261113175845\"}},\"contentRoute\":{\"__typename\":\"ContentRouteResult\",\"listedPathData\":{\"__typename\":\"ContentRouteData\",\"course\":{\"__typename\":\"Course\",\"contentId\":\"xffde7c31\",\"contentKind\":\"Course\",\"courseChallenge\":null,\"curation\":{\"__typename\":\"CurationData\",\"excludedChildren\":[\"Topic:xf409033d\",\"Topic:x5e3717e0\",\"Topic:xf9c6be8d\",\"Topic:x76ccd5a5\",\"Topic:x3dea311d\",\"Topic:xde9be2087fa2350c\"],\"hideCommunityQuestions\":false,\"hideSubjectIntro\":false,\"modules\":[{\"__typename\":\"CourseIntroModule\",\"callToAction\":\"Conheça os profissionais\",\"description\":\"Conheça um profissional: de desenvolvedores de aplicativo de saúde para dispositivos móveis a gerentes de produto e programadores de física. Saiba como eles entraram no setor, o que precisam fazer em seus trabalhos, o que eles fazem por diversão, e que conselho eles têm para você.\",\"kind\":\"SubjectIntro\",\"link\":\"Video:x2c143ebd\",\"title\":\"O que você pode fazer em uma carreira em ciência da computação?\",\"untranslatedFields\":[],\"video\":\"\"},{\"__typename\":\"ActionListModule\",\"actions\":[{\"URL\":\"/computer-programming/new/pjs\",\"__typename\":\"ActionListAction\",\"contentDescriptor\":\"Topic:xffde7c31\",\"text\":\"Novo Programa JavaScript\"},{\"URL\":\"/computer-programming/new/webpage\",\"__typename\":\"ActionListAction\",\"contentDescriptor\":\"Topic:xffde7c31\",\"text\":\"Nova página da Web\"},{\"URL\":\"/computer-programming/new/sql\",\"__typename\":\"ActionListAction\",\"contentDescriptor\":\"Topic:xffde7c31\",\"text\":\"Novo Script SQL\"}],\"kind\":\"ActionList\",\"title\":\"Criar um novo programa\",\"untranslatedFields\":[]},{\"__typename\":\"ActionListModule\",\"actions\":[{\"URL\":\"/computing/computer-programming/projectfeedback\",\"__typename\":\"ActionListAction\",\"contentDescriptor\":\"Topic:xffde7c31\",\"text\":\"Pedidos de ajuda\"},{\"URL\":\"/computing/computer-programming/d\",\"__typename\":\"ActionListAction\",\"contentDescriptor\":\"Topic:xffde7c31\",\"text\":\"Perguntas da comunidade\"}],\"kind\":\"ActionList\",\"title\":\"Comunidade\",\"untranslatedFields\":[]},{\"__typename\":\"BrowseProjectsModule\",\"kind\":\"BrowseProjects\",\"untranslatedFields\":[]},{\"__typename\":\"ActionListModule\",\"actions\":[{\"URL\":\"/computing/computer-science\",\"__typename\":\"ActionListAction\",\"contentDescriptor\":\"Topic:x301707a0\",\"text\":\"Ciência da Computação\"},{\"URL\":\"/computing/hour-of-code\",\"__typename\":\"ActionListAction\",\"contentDescriptor\":\"Topic:x54f76d4b\",\"text\":\"Hora do Código\"},{\"URL\":\"/partner-content/pixar\",\"__typename\":\"ActionListAction\",\"contentDescriptor\":\"Topic:x9efc9f4b\",\"text\":\"Pixar in a Box\"}],\"kind\":\"ActionList\",\"title\":\"Saiba mais sobre computação\",\"untranslatedFields\":[]}],\"sponsorFooterAttribution\":null},\"iconPath\":\"https://cdn.kastatic.org/genfiles/topic-icons/icons/programming.png-e13016-128c.png\",\"id\":\"xffde7c31\",\"isListedForLearners\":true,\"kaLocale\":\"pt\",\"lowerToc\":true,\"masterableExercises\":[],\"masteryChallenge\":null,\"masteryEnabled\":false,\"parent\":{\"__typename\":\"Topic\",\"contentKind\":\"Domain\",\"id\":\"x45aed616\",\"relativeUrl\":\"/computing\",\"slug\":\"computing\",\"translatedTitle\":\"Computação\"},\"relativeUrl\":\"/computing/computer-programming\",\"slug\":\"computer-programming\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Neste curso, você explorará as maravilhas que você pode criar com a programação. Aprenda a programar desenhos, animações e jogos usando JavaScript e a biblioteca Processing, e explore as tecnologias por trás da web conforme você projeta páginas com HTML e CSS.\",\"translatedTitle\":\"Programação de computadores - JavaScript e a web\",\"unitChildren\":[{\"__typename\":\"Unit\",\"allOrderedChildren\":[{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/programming/intro-to-programming/v/programming-intro\",\"contentDescriptor\":\"Video:x7aa228af\",\"contentKind\":\"Video\",\"id\":\"x7aa228af\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8edeb601\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"vx7aa228af\",\"slug\":\"programming-intro\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Programação é o processo de criação de um conjunto de instruções que dizem ao computador como realizar uma tarefa. Podemos programar usando uma variedade de linguagens de programação de computadores, como JavaScript, Python e C++.  Esses programas podem ser aplicados a problemas como controlar robôs enviados a Marte, processar dados médicos, para produzir efeitos especiais em filmes. Aprender JavaScript na Khan Academy é um ótimo ponto de partida, pois os conceitos básicos se aplicam a diferentes linguagens de programação!\\n\",\"translatedTitle\":\"O que é Programação?\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/intro-to-programming/v/programming-intro\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/intro-to-programming/a/learning-programming-on-khan-academy\",\"contentDescriptor\":\"Article:x39a46841\",\"contentKind\":\"Article\",\"id\":\"x39a46841\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8edeb601\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax39a46841\",\"slug\":\"learning-programming-on-khan-academy\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Aprendendo programação na Khan Academy\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/intro-to-programming/a/learning-programming-on-khan-academy\"}],\"id\":\"x8edeb601\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg4ZWRlYjYwMQw\",\"relativeUrl\":\"/computing/computer-programming/programming/intro-to-programming\",\"slug\":\"intro-to-programming\",\"translatedDescription\":\"Se você é novo aqui, assista ao nosso vídeo de introdução e faça um breve tour pelo nosso curso de programação. Então, comece a programar!\",\"translatedTitle\":\"Introdução à programação\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/drawing-basics/pt/making-drawings-with-code\",\"contentDescriptor\":\"Talkthrough:xe7fd4c285496ab91\",\"contentKind\":\"Talkthrough\",\"id\":\"xe7fd4c285496ab91\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xf53d7aa7\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6494798146568192\",\"slug\":\"making-drawings-with-code\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Vamos explicar como desenhar círculos com códigos (JavaScript e ProcessingJS), e, em seguida, você tentará fazê-los em um desafio.\",\"translatedTitle\":\"Desenhando com código\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/drawing-basics/pt/making-drawings-with-code\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/drawing-basics/a/quick-tip-number-scrubbing\",\"contentDescriptor\":\"Article:x84855443\",\"contentKind\":\"Article\",\"id\":\"x84855443\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xf53d7aa7\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax84855443\",\"slug\":\"quick-tip-number-scrubbing\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Dica rápida: depuração de números\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/drawing-basics/a/quick-tip-number-scrubbing\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/drawing-basics/pc/challenge-simple-snowman\",\"contentDescriptor\":\"Challenge:x2273d1f7825b1ec5\",\"contentKind\":\"Challenge\",\"id\":\"x2273d1f7825b1ec5\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xf53d7aa7\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6237247300173824\",\"slug\":\"challenge-simple-snowman\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: boneco de neve simples\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/drawing-basics/pc/challenge-simple-snowman\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/drawing-basics/pt/drawing-more-shapes-with-code\",\"contentDescriptor\":\"Talkthrough:x28c0fc702f6c7644\",\"contentKind\":\"Talkthrough\",\"id\":\"x28c0fc702f6c7644\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xf53d7aa7\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p4704188976726016\",\"slug\":\"drawing-more-shapes-with-code\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Aprenda a desenhar retângulos e retas com código (JavaScript e ProcessingJS).\",\"translatedTitle\":\"Desenhando mais formas com código\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/drawing-basics/pt/drawing-more-shapes-with-code\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/drawing-basics/pc/challenge-waving-snowman\",\"contentDescriptor\":\"Challenge:xe938639bf87b5a76\",\"contentKind\":\"Challenge\",\"id\":\"xe938639bf87b5a76\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xf53d7aa7\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5810350149861376\",\"slug\":\"challenge-waving-snowman\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: boneco de neve acenando\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/drawing-basics/pc/challenge-waving-snowman\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"xf53d7aa7\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhmNTNkN2FhNww\",\"relativeUrl\":\"/computing/computer-programming/programming/drawing-basics\",\"slug\":\"drawing-basics\",\"translatedDescription\":\"Vamos mostrar os conceitos básicos de programação e como desenhar formas.\",\"translatedTitle\":\"Noções básicas de Desenho\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/coloring/pt/coloring-with-code\",\"contentDescriptor\":\"Talkthrough:x45950ca4c74fc60f\",\"contentKind\":\"Talkthrough\",\"id\":\"x45950ca4c74fc60f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2d4b3800\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5352351274237952\",\"slug\":\"coloring-with-code\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Aprenda a escrever código para colorir e contornar seus desenhos usando a linguagem JavaScript e a biblioteca ProcessingJS.\",\"translatedTitle\":\"Colorindo com código\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/coloring/pt/coloring-with-code\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/coloring/a/quick-tip-color-picking\",\"contentDescriptor\":\"Article:x92862546\",\"contentKind\":\"Article\",\"id\":\"x92862546\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2d4b3800\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax92862546\",\"slug\":\"quick-tip-color-picking\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Dica rápida: escolha de cor\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/coloring/a/quick-tip-color-picking\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/coloring/pc/challenge-sunny-snowy-day\",\"contentDescriptor\":\"Challenge:x750cfef5e35eabb5\",\"contentKind\":\"Challenge\",\"id\":\"x750cfef5e35eabb5\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2d4b3800\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5492693445902336\",\"slug\":\"challenge-sunny-snowy-day\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Dia de neve ensolarado\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/coloring/pc/challenge-sunny-snowy-day\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/programming/coloring/v/the-power-of-the-docs\",\"contentDescriptor\":\"Video:xa84559de\",\"contentKind\":\"Video\",\"id\":\"xa84559de\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2d4b3800\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"vxa84559de\",\"slug\":\"the-power-of-the-docs\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Os programadores não precisam memorizar cada função ou comando. Em vez disso, podem consultar a documentação como uma espécie de dicionário de programação para ajudá-los a lembrar os detalhes exatos,  como um nome de função ou seus parâmetros. Use a documentação para transformar as suas ideias em realidade mais rápido! Infelizmente, nem sempre a documentação está traduzida para o português, use os tradutores automáticos para ajudá-lo, caso as informações estejam em inglês.\",\"translatedTitle\":\"O Poder da Documentação\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/coloring/v/the-power-of-the-docs\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/coloring/pp/project-whats-for-dinner\",\"contentDescriptor\":\"Project:x13566a1395f56078\",\"contentKind\":\"Project\",\"id\":\"x13566a1395f56078\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2d4b3800\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2510603406\",\"slug\":\"project-whats-for-dinner\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eAgora que você aprendeu como desenhar e colorir formas, use suas habilidades para fazer algo divertido: o jantar!\\u003c/p\\u003e\\u003cp\\u003eO programa abaixo inclui apenas um prato simples, cabe a você colocar comida no prato. Use formas como \\u003ccode\\u003erect()\\u003c/code\\u003e, ellipse() e triangle() para desenhar a comida no prato. Use fill() e stroke() para colorir a comida. Não se lembra de como usar alguma coisa? Dê uma olhada na guia \\\"Documentação\\\" e clique para obter exemplos.\\\\n\\\\nQuando terminar, mostre para seus amigos e para a sua família. Se ofereça para fazer o jantar de amanhã. :-)\\u003cp\\u003eNão quer fazer o jantar? Desenhe alguma outra refeição então.\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: O que temos para o jantar?\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/coloring/pp/project-whats-for-dinner\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x2d4b3800\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgyZDRiMzgwMAw\",\"relativeUrl\":\"/computing/computer-programming/programming/coloring\",\"slug\":\"coloring\",\"translatedDescription\":\"Mostraremos a você como colorir e desenhar suas formas!\",\"translatedTitle\":\"Colorindo\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/variables/pt/intro-to-variables\",\"contentDescriptor\":\"Talkthrough:xe3c3969b2a117e87\",\"contentKind\":\"Talkthrough\",\"id\":\"xe3c3969b2a117e87\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8686923b\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p825241936\",\"slug\":\"intro-to-variables\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Jessica explica como usar variáveis para armazenar um valor para usá-lo depois. As variáveis são uma parte importante da programação, então preste atenção!\",\"translatedTitle\":\"Introdução às Variáveis\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/variables/pt/intro-to-variables\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/programming/variables/e/exercise--intro-to-variables\",\"contentDescriptor\":\"Exercise:xaa1aa46a\",\"contentKind\":\"Exercise\",\"exerciseLength\":4,\"id\":\"xaa1aa46a\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8686923b\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"exaa1aa46a\",\"slug\":\"exercise--intro-to-variables\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":4,\"upperBound\":6},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Usando variáveis\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/variables/e/exercise--intro-to-variables\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/variables/pc/challenge-bucktooth-bunny\",\"contentDescriptor\":\"Challenge:x96aafc7cb88be5ee\",\"contentKind\":\"Challenge\",\"id\":\"x96aafc7cb88be5ee\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8686923b\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p1912068525\",\"slug\":\"challenge-bucktooth-bunny\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Use o poder das variáveis para dar olhos e dentes maiores ao nosso coelho!\",\"translatedTitle\":\"Desafio: Boris, o Coelho Dentuço\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/variables/pc/challenge-bucktooth-bunny\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/variables/pt/more-on-variables\",\"contentDescriptor\":\"Talkthrough:x82458fcc972e52b6\",\"contentKind\":\"Talkthrough\",\"id\":\"x82458fcc972e52b6\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8686923b\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p848607462\",\"slug\":\"more-on-variables\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Jessica explica mais coisas importantes que você deve saber sobre o uso de variáveis.\",\"translatedTitle\":\"Mais sobre Variáveis\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/variables/pt/more-on-variables\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/variables/pc/challenge-funky-frog\",\"contentDescriptor\":\"Challenge:x85d435e5c96528fc\",\"contentKind\":\"Challenge\",\"id\":\"x85d435e5c96528fc\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8686923b\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2039979798\",\"slug\":\"challenge-funky-frog\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Ajude nosso sapinho a enxergar e a comer usando variáveis para desenhar seus olhos e sua boca.\",\"translatedTitle\":\"Desafio: O Sapo do Brejo\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/variables/pc/challenge-funky-frog\",\"userA