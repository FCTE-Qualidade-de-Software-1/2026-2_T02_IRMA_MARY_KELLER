ntentKind\":\"Exercise\",\"exerciseLength\":4,\"id\":\"xeb00c49b\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x10c7b82a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"exeb00c49b\",\"slug\":\"quiz--text-properties\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":4,\"upperBound\":6},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pratique seu conhecimento em propriedades de texto CSS.\",\"translatedTitle\":\"Mais propriedades de texto CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-text-properties/e/quiz--text-properties\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-text-properties/pt/css-inheritance\",\"contentDescriptor\":\"Talkthrough:xa0973c7dede4bbff\",\"contentKind\":\"Talkthrough\",\"id\":\"xa0973c7dede4bbff\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x10c7b82a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6486573584744448\",\"slug\":\"css-inheritance\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Herança CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-text-properties/pt/css-inheritance\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-text-properties/pp/project-blog\",\"contentDescriptor\":\"Project:x66fe50e3d0972e6d\",\"contentKind\":\"Project\",\"id\":\"x66fe50e3d0972e6d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x10c7b82a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4863952709484544\",\"slug\":\"project-blog\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eUm \\\"blog\\\" (ou \\\"web log\\\") é um diário on-line, que uma ou mais pessoas atualizam com uma frequência determinada, como diariamente, semanalmente, ou mensalmente. Muitos novos programadores mantêm blogs para documentar sua jornada para se tornar um programador, com atualizações sobre o que eles aprenderam e fizeram.\\u003c/p\\u003e\\n        \\n        \\u003cp\\u003eExistem várias \\\"plataformas de blog\\\", como WordPress e Blogger, mas nesse projeto você vai fazer seu próprio blog usando HTML e CSS. Ele deve ter pelo menos 2 publicações e a tabela de conteúdo deve se conectar internamente a cada publicação. Use as propriedades de texto CSS para estilizar seu blog - como alterar o tipo de fonte, a altura da linha e os estilos de fonte  de várias seções.\\u003c/p\\u003e\\n        \\n        \\u003cp\\u003eSe você gosta do seu blog, então você pode usá-lo para documentar sua jornada aqui - faça dele um projeto do seu perfil, e então as pessoas que visitarem seu perfil vão ler sobre sua jornada!\\u003c/p\\u003e\\n        \\n \",\"translatedTitle\":\"Projeto: Blog\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-text-properties/pp/project-blog\",\"userAuthoredContentType\":\"webpage\"}],\"id\":\"x10c7b82a\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgxMGM3YjgyYQw\",\"relativeUrl\":\"/computing/computer-programming/html-css/css-text-properties\",\"slug\":\"css-text-properties\",\"translatedDescription\":\"Aprenda a estilizar seu texto com tipos de fonte, tamanho, espaçamento e alinhamento.\",\"translatedTitle\":\"Propriedades de texto CSS\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css/web-development-tools/a/using-the-browser-developer-tools\",\"contentDescriptor\":\"Article:x1b2aa4de\",\"contentKind\":\"Article\",\"id\":\"x1b2aa4de\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x869e031f\