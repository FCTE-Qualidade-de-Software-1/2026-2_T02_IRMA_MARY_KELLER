ramming/html-css/css-layout-properties/pc/challenge-the-boxer-model\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pt/css-position\",\"contentDescriptor\":\"Talkthrough:x81af87de20723afb\",\"contentKind\":\"Talkthrough\",\"id\":\"x81af87de20723afb\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4615703178248192\",\"slug\":\"css-position\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Posição CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pt/css-position\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pc/challenge-position-planet\",\"contentDescriptor\":\"Challenge:xf6f727fed1df6342\",\"contentKind\":\"Challenge\",\"id\":\"xf6f727fed1df6342\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5153121644052480\",\"slug\":\"challenge-position-planet\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Posicionamento do planeta\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pc/challenge-position-planet\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/v/css-in-the-wild-google-maps\",\"contentDescriptor\":\"Video:x3f1a907e\",\"contentKind\":\"Video\",\"id\":\"x3f1a907e\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"vx3f1a907e\",\"slug\":\"css-in-the-wild-google-maps\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Vamos explorar as propriedades de posicionamento do CSS e z-index no Google Maps usando as ferramentas de desenvolvimento do nosso navegador para inspecionar o código CSS. Essas propriedades são usadas para camadas e elementos de posicionamento na página, como o mini mapa, informações que aparecem quando você passa o mouse, e o botão de zoom. Veja como os conceitos de CSS que estamos aprendendo são aplicados em sites complexos e interativos que usamos todos os dias!\",\"translatedTitle\":\"CSS: Google Maps\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/v/css-in-the-wild-google-maps\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pt/css-floating-elements\",\"contentDescriptor\":\"Talkthrough:x1007f5d23dee9ad3\",\"contentKind\":\"Talkthrough\",\"id\":\"x1007f5d23dee9ad3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4635563442569216\",\"slug\":\"css-floating-elements\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Elementos CSS flutuantes\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pt/css-floating-elements\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pc/challenge-floating-clouds\",\"contentDescriptor\":\"Challenge:xc6ccc133c7b23ff9\",\"contentKind\":\"Challenge\",\"id\":\"xc6ccc133c7b23ff9\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5435078412075008\",\"slug\":\"challenge-floating-clouds\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Nuvens flutuantes\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pc/challenge-floating-clouds\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/e/quiz--css-layout\",\"contentDescriptor\":\"Exercise:x46958c79\",\"contentKind\":\"Exercise\",\"exerciseLength\":5,\"id\":\"x46958c79\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ex46958c79\",\"slug\":\"quiz--css-layout\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":5,\"upperBound\":8},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pratique propriedades e conceitos de layout em CSS.\",\"translatedTitle\":\"Usando propriedades de leiaute CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/e/quiz--css-layout\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/a/planning-your-webpage\",\"contentDescriptor\":\"Article:xcbf6fe3e\",\"contentKind\":\"Article\",\"id\":\"xcbf6fe3e\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"axcbf6fe3e\",\"slug\":\"planning-your-webpage\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Planejando sua página web\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/a/planning-your-webpage\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pp/project-event-invite\",\"contentDescriptor\":\"Project:x71333e3f134714a9\",\"contentKind\":\"Project\",\"id\":\"x71333e3f134714a9\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6750832828350464\",\"slug\":\"project-event-invite\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eNesse projeto, você vai fazer um convite para um evento - uma festa, um workshop, um casamento, ou o que você quiser. Ele deve ter o título do evento, os detalhes e talvez uma lista de convidados ou um botão de confirmação.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eAntes de começar a programar, é importante que você faça o \\\"protótipo\\\" - fazer o planejamento em papel ou com uma ferramenta apropriada. Esboce a visão que você tem na cabeça e faça alguns protótipos até ficar satisfeito.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eQuando você estiver pronto, tente implementar seu convite para o evento em HTML/CSS. Se você tiver problemas com alguma coisa que é difícil de transferir do papel para o HTML, tente pesquisar na internet ou clique em \\\"Pedir ajuda\\\". Eu aposto que você vai aprender alguma coisa no processo.\\u003c/p\\u003e\\n \",\"translatedTitle\":\"Projeto: convite de evento\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pp/project-event-invite\",\"userAuthoredContentType\":\"webpage\"}],\"id\":\"x6787034c\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg2Nzg3MDM0Yww\",\"relativeUrl\":\"/computing/computer-programming/html-css/css-layout-properties\",\"slug\":\"css-layout-properties\",\"translatedDescription\":\"Aprenda a usar os elementos HTML span e div com propriedades CSS, como posicionamento e flutuação, para alterar o layout de suas páginas web.\",\"translatedTitle\":\"Layout CSS\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/using-multiple-css-classes\",\"contentDescriptor\":\"Talkthrough:xd86b6f05048cdbbc\",\"contentKind\":\"Talkthrough\",\"id\":\"xd86b6f05048cdbbc\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4939299519987712\",\"slug\":\"using-multiple-css-classes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Uso de várias classes CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pt/using-multiple-css-classes\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/combining-css-class-and-element-selectors\",\"contentDescriptor\":\"Talkthrough:x488457332bf1f0ed\",\"contentKind\":\"Talkthrough\",\"id\":\"x488457332bf1f0ed\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5418858455498752\",\"slug\":\"combining-css-class-and-element-selectors\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Combinação de classes CSS e seletores de elementos\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pt/combining-css-class-and-element-selectors\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/css-descendant-selectors\",\"contentDescriptor\":\"Talkthrough:xe319712ad3615f58\",\"contentKind\":\"Talkthrough\",\"id\":\"xe319712ad3615f58\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6374633634004992\",\"slug\":\"css-descendant-selectors\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"