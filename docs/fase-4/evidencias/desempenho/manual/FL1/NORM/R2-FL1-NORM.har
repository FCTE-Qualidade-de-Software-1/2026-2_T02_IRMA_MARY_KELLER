/computer-programming/html-css/more-css-selectors/e/quiz--css-specificity-rules\"}],\"id\":\"x2e46f213\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgyZTQ2ZjIxMww\",\"relativeUrl\":\"/computing/computer-programming/html-css/more-css-selectors\",\"slug\":\"more-css-selectors\",\"translatedDescription\":\"Aprenda seletores mais complexos - usando várias classes, combinando elementos com classes, seletores descendentes, seletores agrupados e pseudoclasses dinâmicas.\",\"translatedTitle\":\"Mais seletores CSS\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-css-further-learning/a/webpage-design\",\"contentDescriptor\":\"Article:x9ccc09f7\",\"contentKind\":\"Article\",\"id\":\"x9ccc09f7\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3c59ea3c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ax9ccc09f7\",\"slug\":\"webpage-design\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Design de página web\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-css-further-learning/a/webpage-design\"},{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-css-further-learning/v/html-validation\",\"contentDescriptor\":\"Video:x375b2a8b\",\"contentKind\":\"Video\",\"id\":\"x375b2a8b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3c59ea3c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"vx375b2a8b\",\"slug\":\"html-validation\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Navegadores podem se adaptar e mostrar páginas web mesmo quando há erros no código. No entanto, para garantir que sua página funcione de forma consistente em navegadores diferentes, é uma boa ideia validar seu HTML usando o serviço de validação do W3. Vamos mostrar como usar o serviço do validador W3C para arrumar erros comuns, como esquecer de incluir atributos em imagens.\",\"translatedTitle\":\"Validação HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-css-further-learning/v/html-validation\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-css-further-learning/e/quiz--validate-this-html\",\"contentDescriptor\":\"Exercise:x488fb047\",\"contentKind\":\"Exercise\",\"exerciseLength\":4,\"id\":\"x488fb047\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3c59ea3c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ex488fb047\",\"slug\":\"quiz--validate-this-html\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":4,\"upperBound\":6},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Tente validar pequenas páginas HTML e descubra o que está errado.\",\"translatedTitle\":\"Validando HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-css-further-learning/e/quiz--validate-this-html\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-css-further-learning/a/html-css-further-learning-what-to-learn-next\",\"contentDescriptor\":\"Article:xd2d98915\",\"contentKind\":\"Article\",\"id\":\"xd2d98915\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3c59ea3c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"axd2d98915\",\"slug\":\"html-css-further-learning-what-to-learn-next\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"O que aprender a seguir\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-css-further-learning/a/html-css-further-learning-what-to-learn-next\"}],\"id\":\"x3c59ea3c\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgzYzU5ZWEzYww\",\"relativeUrl\":\"/computing/computer-programming/html-css/html-css-further-learning\",\"slug\":\"html-css-further-learning\",\"translatedDescription\":\"O que você pode fazer para continuar aprendendo HTML e CSS?\",\"translatedTitle\":\"Aprendizagem futura\"}],\"iconPath\":\"https://cdn.kastatic.org/genfiles/topic-icons/icons/markup.png-8a1e75-128c.png\",\"id\":\"x7441c73b\",\"isListedForLearners\":true,\"learnableContentSummary\":{\"__typename\":\"LearnableContentSummary\",\"countExercises\":5},\"masteryEnabled\":false,\"relativeUrl\":\"/computing/computer-programming/html-css\",\"slug\":\"html-css\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Aprenda a usar HTML e CSS para criar páginas web. HTML é a linguagem de marcação com a qual você envolve o conteúdo, para instruir os navegadores sobre cabeçalhos, listas, tabelas, etc. CSS é a linguagem de estilos que você usa para estilizar a página, para instruir os navegadores a alterar a cor, a fonte, o layout e muito mais.\",\"translatedTitle\":\"Introdução a HTML/CSS: criação de páginas Web\",\"unlistedAncestorIds\":null},{\"__typename\":\"Unit\",\"allOrderedChildren\":[{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/v/welcome-to-sql\",\"contentDescriptor\":\"Video:xe44b888f\",\"contentKind\":\"Video\",\"id\":\"xe44b888f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"vxe44b888f\",\"slug\":\"welcome-to-sql\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"SQL ou linguagem de consulta estruturada (Structured Querry Language em inglês), é uma linguagem especificamente concebida para acessar e interagir com bancos de dados. Ela permite aos usuários criar tabelas, modificar dados e recuperar informações de forma rápida e eficiente. O SQL é uma das linguagens de consulta mais populares em uso hoje.\",\"translatedTitle\":\"Bem-vindo ao SQL\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/v/welcome-to-sql\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pt/creating-a-table-and-inserting-data\",\"contentDescriptor\":\"Talkthrough:x245bbc2f163a845d\",\"contentKind\":\"Talkthrough\",\"id\":\"x245bbc2f163a845d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6503853165117440\",\"slug\":\"creating-a-table-and-inserting-data\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Criando uma tabela e inserindo dados\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pt/creating-a-table-and-inserting-data\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-book-list-database\",\"contentDescriptor\":\"Challenge:x4730b42e816fe5e0\",\"contentKind\":\"Challenge\",\"id\":\"x4730b42e816fe5e0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p4845950473601024\",\"slug\":\"challenge-book-list-database\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Armazene seus livros favoritos em uma tabela\",\"translatedTitle\":\"Desafio: Banco de dados com lista de livros\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-book-list-database\",\"userAuthoredContentType\":\"sql\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pt/querying-the-table\",\"contentDescriptor\":\"Talkthrough:x164d4f53db1bd546\",\"contentKind\":\"Talkthrough\",\"id\":\"x164d4f53db1bd546\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6003599625945088\",\"slug\":\"querying-the-table\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Consultar a tabela\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pt/querying-the-table\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-box-office-hits-database\",\"contentDescriptor\":\"Challenge:xd89c8bb8523d3c0d\",\"contentKind\":\"Challenge\",\"id\":\"xd89c8bb8523d3c0d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6304653454344192\",\"slug\":\"challenge-box-office-hits-database\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Consulte um banco de dados de filmes de maneiras diferentes.\",\"translatedTitle\":\"Desafio: Banco de dados de sucessos de bilheteria\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-box-office-hits-database\",\"userAuthoredContentType\":\"sql\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pt/aggregating-data\",\"contentDescriptor\":\"Talkthrough:x7a36dc5b66098882\",\"contentKind\":\"Talkthrough\",\"id\":\"x7a36dc5b66098882\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6288707168763904\",\"slug\":\"aggregating-data\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Agregando dados\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pt/aggregating-data\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-todo-list-database-stats\",\"contentDescriptor\":\"Challenge:xc23c12790f4cf614\",\"contentKind\":\"Challenge\",\"id\":\"xc23c12790f4cf614\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5826099759284224\",\"slug\":\"challenge-todo-list-database-stats\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Estatísticas de consulta de uma lista de afazeres.\",\"translatedTitle\":\"Desafio: Estatísticas do banco de dados de lista de afazeres\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-todo-list-database-stats\",\"userAuthoredContentType\":\"sql\"},{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/v/s-q-l-or-sequel\",\"contentDescriptor\":\"Video:xab93c62d\",\"contentKind\":\"Video\",\"id\":\"xab93c62d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"vxab93c62d\",\"slug\":\"s-q-l-or-sequel\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Como pronunciar SQL? Quando a IBM inventou o SQL, que significa Structured Querry Language (linguagem de consulta estruturada), eles originalmente a chamaral de SEQUEL. No entanto, depois eles acabaram mudando o nome para SQL por questões de registro de marca. Muitas pessoas ainda pronunciam SQL como \\\"sequel\\\" por razões históricas, enquanto outros pronunciam como \\\"S-Q-L\\\". As duas pronúncias são corretas e comumente usadas!\",\"translatedTitle\":\"S Q L ou SEQUEL?\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/v/s-q-l-or-sequel\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pp/project-design-a-store-database\",\"contentDescriptor\":\"Project:xfef09f28eed4ae90\",\"contentKind\":\"Project\",\"id\":\"xfef09f28eed4ae90\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5327101046816768\",\"slug\":\"project-design-a-store-database\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Crie sua própria loja! Ela deve vender um tipo de produto como roupas, bicicletas ou qualquer coisa que seja de seu interesse. Você deve ter uma tabela para todos os itens na sua loja e pelo menos 5 colunas para o tipo de dado que você considera armazenar. Você deve vender pelo menos 15 itens e usar as instruções select para ordenar seus itens por preço e mostrar pelo menos uma estatística sobre os itens.\\n\",\"translatedTitle\":\"Projeto: Projetar o banco de dados de uma loja\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pp/project-design-a-store-database\",\"userAuthoredContentType\":\"sql\"}],\"id\":\"x8c9afe49\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg4YzlhZmU0OQw\",\"relativeUrl\":\"/computing/computer-programming/sql/sql-basics\",\"slug\":\"sql-basics\",\"translatedDescription\":\"Vamos lhe mostrar os conceitos básicos da criação de tabelas e da seleção de dados de várias formas diferentes.\",\"translatedTitle\":\"Noções básicas de SQL\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pt/more-complex-queries-with-andor\",\"contentDescriptor\":\"Talkthrough:x4d8b0a9d3f1b5c4a\",\"contentKind\":\"Talkthrough\",\"id\":\"x4d8b0a9d3f1b5c4a\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x65157cda\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6658097900814336\",\"slug\":\"more-complex-queries-with-andor\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"trans