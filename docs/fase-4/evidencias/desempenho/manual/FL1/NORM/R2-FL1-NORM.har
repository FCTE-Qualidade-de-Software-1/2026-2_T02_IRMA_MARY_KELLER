8679955c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axe27aefb0\",\"slug\":\"vector-magnitude-normalization\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Magnitude e normalização de vetores\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/a/vector-magnitude-normalization\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/a/vector-motion\",\"contentDescriptor\":\"Article:xd3aedd63\",\"contentKind\":\"Article\",\"id\":\"xd3aedd63\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8679955c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axd3aedd63\",\"slug\":\"vector-motion\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Movimento de vetores\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/a/vector-motion\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/pc/challenge-braking-car\",\"contentDescriptor\":\"Challenge:x871e940d378b56c3\",\"contentKind\":\"Challenge\",\"id\":\"x871e940d378b56c3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8679955c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p6690331079737344\",\"slug\":\"challenge-braking-car\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Faça com que seja possível mover e parar o carro com o teclado.\",\"translatedTitle\":\"Desafio: Freando o carro\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/pc/challenge-braking-car\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/a/static-functions-vs-instance-methods\",\"contentDescriptor\":\"Article:xb8015853\",\"contentKind\":\"Article\",\"id\":\"xb8015853\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8679955c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axb8015853\",\"slug\":\"static-functions-vs-instance-methods\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Funções estáticas vs. métodos de instância\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/a/static-functions-vs-instance-methods\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/a/interactive-vector-motion\",\"contentDescriptor\":\"Article:xecd398be\",\"contentKind\":\"Article\",\"id\":\"xecd398be\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8679955c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axecd398be\",\"slug\":\"interactive-vector-motion\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Movimento interativo de vetor\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/a/interactive-vector-motion\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/pc/challenge-mouse-stalker\",\"contentDescriptor\":\"Challenge:xd7086a42ffa8b04a\",\"contentKind\":\"Challenge\",\"id\":\"xd7086a42ffa8b04a\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8679955c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p4665445528371200\",\"slug\":\"challenge-mouse-stalker\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Faça um objeto em movimento acelerar com base em sua distância do mouse.\",\"translatedTitle\":\"Desafio: Rastreador de mouse\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/pc/challenge-mouse-stalker\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/pp/project-computational-creatures\",\"contentDescriptor\":\"Project:x651facb92f0905a2\",\"contentKind\":\"Project\",\"id\":\"x651facb92f0905a2\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8679955c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p5964450937962496\",\"slug\":\"project-computational-creatures\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"  \\u003cimg src=\\\"https://cdn.kastatic.org/ka-perseus-images/7bbcaddc11804d8d18c538e635dceb86d43c2218.png\\\" style=\\\"float:right; width:200px;margin:10px;\\\"\\u003e\\n  \\u003cp\\u003eNo resto do curso de Simulações Naturais, nossos projetos serão  direcionados para a criação de uma simulação de um ecossistema. Imagine uma população de criaturas virtuais nadando em uma lagoa digital, interagindo umas com as outras de acordo com várias regras. Agora que você sabe o básico sobre vetores e movimentos, você pode começar a criar essas criaturas!\\u003c/p\\u003e\\n  \\n  \\u003cp\\u003ePara este primeiro projeto de ecossistema, comece com o exemplo de código básico de \\u003ccode\\u003eMover\\u003c/code\\u003e. Desenvolva um conjunto de regras para simular o comportamento de uma criatura do mundo real, como um mosquito nervoso, um peixe nadando, um coelho saltitante, uma cobra rastejante, etc. Controle o movimento dos objetos apenas manipulando a aceleração, usando o que você aprendeu até agora. Tente dar à criatura uma personalidade com seu comportamento, e não com seu design visual - ou faça dos dois jeitos, se seus dotes artísticos forem bons. Divirta-se!\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: Criaturas computacionais\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors/pp/project-computational-creatures\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x8679955c\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg4Njc5OTU1Yww\",\"relativeUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-vectors\",\"slug\":\"programming-vectors\",\"translatedDescription\":\"\",\"translatedTitle\":\"Vetores\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/newtons-laws-of-motion\",\"contentDescriptor\":\"Article:xb42d69f3\",\"contentKind\":\"Article\",\"id\":\"xb42d69f3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axb42d69f3\",\"slug\":\"newtons-laws-of-motion\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Leis de movimento de Newton\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/newtons-laws-of-motion\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/pc/challenge-floating-balloon\",\"contentDescriptor\":\"Challenge:x5c2840b91ec1d9e0\",\"contentKind\":\"Challenge\",\"id\":\"x5c2840b91ec1d9e0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p6620731336032256\",\"slug\":\"challenge-floating-balloon\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Faça um balão flutuar até o teto e depois saltar para fora.\",\"translatedTitle\":\"Desafio: Balão flutuante\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/pc/challenge-floating-balloon\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/motion-of-many-objects\",\"contentDescriptor\":\"Article:xc834d631\",\"contentKind\":\"Article\",\"id\":\"xc834d631\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axc834d631\",\"slug\":\"motion-of-many-objects\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Movimento de diversos objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/motion-of-many-objects\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/modeling-gravity-and-friction\",\"contentDescriptor\":\"Article:x7cd77a99\",\"contentKind\":\"Article\",\"id\":\"x7cd77a99\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax7cd77a99\",\"slug\":\"modeling-gravity-and-friction\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Modelando a gravidade e o atrito\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/modeling-gravity-and-friction\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/air-and-fluid-resistance\",\"contentDescriptor\":\"Article:xf8f388d5\",\"contentKind\":\"Article\",\"id\":\"xf8f388d5\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axf8f388d5\",\"slug\":\"air-and-fluid-resistance\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Resistência do ar e dos fluidos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/air-and-fluid-resistance\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/gravitational-attraction\",\"contentDescriptor\":\"Article:x8fccccf5\",\"contentKind\":\"Article\",\"id\":\"x8fccccf5\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax8fccccf5\",\"slug\":\"gravitational-attraction\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Atração gravitacional\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/gravitational-attraction\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/pc/challenge-artwork-generator\",\"contentDescriptor\":\"Challenge:x497626fd6a1b2db6\",\"contentKind\":\"Challenge\",\"id\":\"x497626fd6a1b2db6\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p5898834038226944\",\"slug\":\"challenge-artwork-generator\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Crie belas obras de arte com base no movimento em torno de um ponto de atração.\",\"translatedTitle\":\"Desafio: Gerador de arte\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/pc/challenge-artwork-generator\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/mutual-attraction\",\"contentDescriptor\":\"Article:xe181098a\",\"contentKind\":\"Article\",\"id\":\"xe181098a\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axe181098a\",\"slug\":\"mutual-attraction\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Atração mútua\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/a/mutual-attraction\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/pp/project-creature-comforts-and-critter-jitters\",\"contentDescriptor\":\"Project:xd49edccaa7a72b97\",\"contentKind\":\"Project\",\"id\":\"xd49edccaa7a72b97\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xddaab832\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p5627964862496768\",\"slug\":\"project-creature-comforts-and-critter-jitters\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cimg src=\\\"https://cdn.kastatic.org/ka-perseus-images/7bbcaddc11804d8d18c538e635dceb86d43c2218.png\\\" style=\\\"float:right; width:200px;margin:10px;\\\"\\u003e\\n\\u003cp\\u003eComece com a criatura que você criou no projeto anterior, e cole o código aqui.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eIncorpore o conceito de forças no seu ecossistema:\\u003c/p\\u003e\\n\\n\\u003cp\\u003eTente introduzir outros elementos no ambiente (comida, um predador) para que a criatura interaja com eles.\\u003c/p\\u003e\\n\\u003cp\\u003eA criatura experimenta atração ou repulsão pelas coisas em seu mundo?\\u003c/p\\u003e\\n\\u003cp\\u003eVocê pode pensar de maneira mais abstrata e atribuir forças com base nos desejos ou objetivos da criatura?\\u003c/p\\u003e\\n\",\"translatedTitle\":\"Projeto: Ameaças e benefícios para a criatura\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-forces/pp/project-creature-comforts-and-critter-jitters\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"xddaab832\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhkZGFhYjgzMgw\",\"relativeUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-forces\",\"slug\":\"programming-forces\",\"translatedDescription\":\"\",\"translatedTitle\":\"Forças\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/angles-and-units\",\"contentDescriptor\":\"Article:x026c6d2e\",\"contentKind\":\"Article\",\"id\":\"x026c6d2e\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3be54d3a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax026c6d2e\",\"slug\":\"angles-and-units\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Ângulos e unidades\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/angles-and-units\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/angular-velocity\",\"contentDescriptor\":\"Article:xbbba5b5f\",\"contentKind\":\"Article\",\"id\":\"xbbba5b5f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3be54d3a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axbbba5b5f\",\"slug\":\"angular-velocity\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Velocidade angular\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/angular-velocity\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/trigonometry\",\"contentDescriptor\":\"Article:x408a37dc\",\"contentKind\":\"Article\",\"id\":\"x408a37dc\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3be54d3a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax408a37dc\",\"slug\":\"trigonometry\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Trigonometria\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/trigonometry\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/math/geometry/hs-geo-trig/hs-geo-trig-ratios-intro/e/trigonometry_1\",\"contentDescriptor\":\"Exercise:3036\",\"contentKind\":\"Exercise\",\"exerciseLength\":4,\"id\":\"3036\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc2cc797b\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7597fbbe\",\"masteryEnabled\":true}},\"progressKey\":\"e3036\",\"slug\":\"trigonometry_1\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":4,\"upperBound\":6},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Dado o comprimento do lado de um triângulo retângulo, encontre o seno, cosseno ou tangente de um dos ângulos agudos.\",\"translatedTitle\":\"Razões trigonométricas em triângulos retângulos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/e/trigonometry_1\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/pointing-towards-movement\",\"contentDescriptor\":\"Article:x70ac0811\",\"contentKind\":\"Article\",\"id\":\"x70ac0811\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3be54d3a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax70ac0811\",\"slug\":\"pointing-towards-movement\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Apontando na direção do movimento\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/pointing-towards-movement\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/polar-coordinates\",\"contentDescriptor\":\"Article:xf02483ce\",\"contentKind\":\"Article\",\"id\":\"xf02483ce\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3be54d3a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axf02483ce\",\"slug\":\"polar-coordinates\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Coordenadas polares\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/a/polar-coordinates\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/pp/project-asteroids-spaceship\",\"contentDescriptor\":\"Project:x3a8f48e87bb90643\",\"contentKind\":\"Project\",\"id\":\"x3a8f48e87bb90643\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3be54d3a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p4731110142509056\",\"slug\":\"project-asteroids-spaceship\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cimg src=\\\"https://cdn.kastatic.org/ka-cs-challenge-images/asteroids.gif\\\" style=\\\"float:right; border:1px solid black; width:150px;\\\"\\u003e\\n\\u003cp\\u003eSimule a espaçonave do clássico jogo Asteroids. Etapas sugeridas:\\u003c/p\\u003e\\n\\u003col class=\\\"styled-list\\\"\\u003e\\n \\u003cli\\u003eComece com um dos exemplos do objeto Mover.\\u003c/li\\u003e\\n \\u003cli\\u003eDesenhe a espaçonave com um triângulo e dois propulsores na parte inferior.\\u003c/li\\u003e\\n \\u003cli\\u003eReaja quando o usuário pressionar as teclas: se ele pressionar a seta esquerda, vire à esquerda, e se pressionar a seta direita, vire à direita. \\u003c/li\\u003e\\n  \\u003cli\\u003eSe o usuário pressionar a tecla z, aplique uma força propulsora que acelera na direção em que a espaçonave está apontando.\\u003c/li\\u003e\\n  \\u003cli\\u003eFaça com que a espaçonave não ultrapasse os limites da tela.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\",\"translatedTitle\":\"Projeto: Nave espacial Asteroids\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement/pp/project-asteroids-spaceship\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x3be54d3a\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgzYmU1NGQzYQw\",\"relativeUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-angular-movement\",\"slug\":\"programming-angular-movement\",\"translatedDescription\":\"\",\"translatedTitle\":\"Movimento Angular\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/oscillation-amplitude-and-period\",\"contentDescriptor\":\"Article:x69c14b57\",\"contentKind\":\"Article\",\"id\":\"x69c14b57\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x68193720\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax69c14b57\",\"slug\":\"oscillation-amplitude-and-period\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Amplitude e período da oscilação\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/oscillation-amplitude-and-period\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/oscillation-with-angular-velocity\",\"contentDescriptor\":\"Article:x27be0012\",\"contentKind\":\"Article\",\"id\":\"x27be0012\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x68193720\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax27be0012\",\"slug\":\"oscillation-with-angular-velocity\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Oscilação com velocidade angular\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/oscillation-with-angular-velocity\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/waves\",\"contentDescriptor\":\"Article:x7bf0ae1a\",\"contentKind\":\"Article\",\"id\":\"x7bf0ae1a\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x68193720\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax7bf0ae1a\",\"slug\":\"waves\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Ondas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/waves\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/trig-and-forces-the-pendulum\",\"contentDescriptor\":\"Article:x138b0da9\",\"contentKind\":\"Article\",\"id\":\"x138b0da9\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x68193720\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax138b0da9\",\"slug\":\"trig-and-forces-the-pendulum\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Trigonometria e forças: o pêndulo\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/trig-and-forces-the-pendulum\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/pc/challenge-pendulum-puppet\",\"contentDescriptor\":\"Challenge:xc996434ed1c64e8c\",\"contentKind\":\"Challenge\",\"id\":\"xc996434ed1c64e8c\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x68193720\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p5440447211110400\",\"slug\":\"challenge-pendulum-puppet\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Faça os membros do boneco balançarem e se conectarem uns aos outros.\",\"translatedTitle\":\"Desafio: Boneco de pêndulos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/pc/challenge-pendulum-puppet\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/spring-forces\",\"contentDescriptor\":\"Article:xd855d270\",\"contentKind\":\"Article\",\"id\":\"xd855d270\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x68193720\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axd855d270\",\"slug\":\"spring-forces\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Forças de mola\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/a/spring-forces\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/pp/project-curling-crawling-circling-creatures\",\"contentDescriptor\":\"Project:xf0b41001c6463606\",\"contentKind\":\"Project\",\"id\":\"xf0b41001c6463606\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x68193720\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p5931294394417152\",\"slug\":\"project-curling-crawling-circling-creatures\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cimg src=\\\"https://cdn.kastatic.org/ka-perseus-images/7bbcaddc11804d8d18c538e635dceb86d43c2218.png\\\" style=\\\"float:right; width:200px;margin:10px;\\\"\\u003e\\n\\u003cp\\u003eComece usando seu código do projeto de ecossistema anterior, e cole-o aqui.\\u003c/p\\u003e\\n\\n\\u003cp\\u003ePegue uma das suas criaturas e incorpore oscilação ao seu movimento, usando o objeto Oscillator que criamos como base. Esse objeto Oscillator, contudo, oscila em torno de um único ponto (o meio da janela). Tente fazer a oscilação em torno de um ponto em movimento. Em outras palavras, crie uma criatura que se move pela tela de acordo com a localização, a velocidade, e a aceleração. Mas essa criatura não é simplesmente uma forma estática, ela é um corpo que oscila. Considere relacionar a velocidade de oscilação à velocidade de movimento. Pense em uma borboleta batendo asas, ou nas patas de um inseto. Você pode fazer parecer que os mecanismos internos da criatura (oscilação) guiam sua locomoção?\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: Criaturas que ondulam, rastejam, e giram\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations/pp/project-curling-crawling-circling-creatures\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x68193720\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg2ODE5MzcyMAw\",\"relativeUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-oscillations\",\"slug\":\"programming-oscillations\",\"translatedDescription\":\"\",\"translatedTitle\":\"Oscilações\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/intro-to-particle-systems\",\"contentDescriptor\":\"Article:x71d882c8\",\"contentKind\":\"Article\",\"id\":\"x71d882c8\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xee1dab0c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax71d882c8\",\"slug\":\"intro-to-particle-systems\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Introdução a sistemas de partículas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/intro-to-particle-systems\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/a-single-particle\",\"contentDescriptor\":\"Article:xd52f898d\",\"contentKind\":\"Article\",\"id\":\"xd52f898d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xee1dab0c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axd52f898d\",\"slug\":\"a-single-particle\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Uma partícula única\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/a-single-particle\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/a-particle-system\",\"contentDescriptor\":\"Article:x30910cd4\",\"contentKind\":\"Article\",\"id\":\"x30910cd4\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xee1dab0c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax30910cd4\",\"slug\":\"a-particle-system\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Um sistema de partículas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/a-particle-system\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/systems-of-particle-systems\",\"contentDescriptor\":\"Article:x99106fe8\",\"contentKind\":\"Article\",\"id\":\"x99106fe8\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xee1dab0c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax99106fe8\",\"slug\":\"systems-of-particle-systems\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Sistemas de sistemas de partículas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/systems-of-particle-systems\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/particle-types\",\"contentDescriptor\":\"Article:x207aa648\",\"contentKind\":\"Article\",\"id\":\"x207aa648\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xee1dab0c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax207aa648\",\"slug\":\"particle-types\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Tipos de partículas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/particle-types\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/particle-systems-with-forces\",\"contentDescriptor\":\"Article:x1fcfa7f9\",\"contentKind\":\"Article\",\"id\":\"x1fcfa7f9\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xee1dab0c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax1fcfa7f9\",\"slug\":\"particle-systems-with-forces\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Sistemas de partículas com forças\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/a/particle-systems-with-forces\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/pp/project-creature-colonies\",\"contentDescriptor\":\"Project:x6f10ff25d66d773f\",\"contentKind\":\"Project\",\"id\":\"x6f10ff25d66d773f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xee1dab0c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p5000693227192320\",\"slug\":\"project-creature-colonies\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cimg src=\\\"https://cdn.kastatic.org/ka-perseus-images/7bbcaddc11804d8d18c538e635dceb86d43c2218.png\\\" style=\\\"float:right; width:200px;margin:10px;\\\"\\u003e\\n\\u003cp\\u003eComece com seu código dos projetos de ecossistema anteriores, e cole-o aqui.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eAgora, crie um \\u003cstrong\\u003esistema\\u003c/strong\\u003e de criaturas. Como elas podem interagir umas com as outras? Você pode usar herança para criar uma variedade de criaturas, derivadas do mesmo código base? Desenvolva uma metodologia para como elas competem por recursos (como comida, por exemplo). Você pode monitorar a “saúde” de uma criatura como fizemos para monitorar o tempo de vida de uma partícula, removendo criaturas quando for apropriado? Que regras você pode incorporar para controlar como as criaturas nascem?\\n\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: Colônias de criaturas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems/pp/project-creature-colonies\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"xee1dab0c\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhlZTFkYWIwYww\",\"relativeUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-particle-systems\",\"slug\":\"programming-particle-systems\",\"translatedDescription\":\"\",\"translatedTitle\":\"Sistemas de partículas\"}],\"iconPath\":\"https://cdn.kastatic.org/genfiles/topic-icons/icons/simulations.png-955b92-128c.png\",\"id\":\"xc9115e5d\",\"isListedForLearners\":true,\"learnableContentSummary\":{\"__typename\":\"LearnableContentSummary\",\"countExercises\":1},\"masteryEnabled\":false,\"relativeUrl\":\"/computing/computer-programming/programming-natural-simulations\",\"slug\":\"programming-natural-simulations\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Depois de fazer a introdução ao JS, você pode fazer este curso para aprender a combinar JS, ProcessingJS e conceitos matemáticos para simular a natureza em seus programas. Este curso é uma extensão do livro \\\"The Nature of Code\\\" (A Natureza do Código, em tradução livre), de Daniel Shiffman (natureofcode.com), utilizado sob a licença CC BY-NC.\",\"translatedTitle\":\"JS avançado: Simulações Naturais\",\"unlistedAncestorIds\":null},{\"__typename\":\"Unit\",\"allOrderedChildren\":[{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/html-css-js/html-css-js-intro/v/welcome-to-making-webpages-interactive\",\"contentDescriptor\":\"Video:x103d3952\",\"contentKind\":\"Video\",\"id\":\"x103d3952\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x44a77658\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xb254f8dc\",\"masteryEnabled\":false}},\"progressKey\":\"vx103d3952\",\"slug\":\"welcome-to-making-webpages-interactive\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"JavaScript foi originalmente desenvolvida para tornar os sites interativos, mas hoje em dia ela pode ser usada para tudo, desde o carregamento de servidores, o desenho de animações, até o processamento de dados. Sites começam com páginas web simples HTML e CSS e, em seguida, usam JavaScript para permitir que os usuários interajam com elas!\",\"translatedTitle\":\"Bem-vindo à criação de páginas web interativas\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css-js/html-css-js-intro/v/welcome-to-making-webpages-interactive\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css-js/html-css-js-intro/a/review-htmlcss\",\"contentDescriptor\":\"Article:x5ab7a345\",\"contentKind\":\"Article\",\"id\":\"x5ab7a345\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x44a77658\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xb254f8dc\",\"masteryEnabled\":false}},\"progressKey\":\"ax5ab7a345\",\"slug\":\"review-htmlcss\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Revisão de HTML/CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css-js/html-css-js-intro/a/review-htmlcss\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/html-css-js/html-css-js-intro/e/quiz--html-css-recap\",\"contentDescriptor\":\"Exercise:xcfabb252\",\"contentKind\":\"Exercise\",\"exerciseLength\":5,\"id\":\"xcfabb252\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x44a77658\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xb254f8dc\",\"masteryEnabled\":false}},\"progressKey\":\"excfabb252\",\"slug\":\"quiz--html-css-recap\",\"sponsored\":false,\"thumbnailUrl\"