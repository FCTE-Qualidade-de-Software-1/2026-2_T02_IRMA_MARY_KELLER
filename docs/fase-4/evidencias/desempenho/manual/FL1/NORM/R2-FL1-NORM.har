"id\":\"x3312fbc8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5095047773683712\",\"slug\":\"making-animations\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como programar animações usando a função draw().\",\"translatedTitle\":\"Fazendo animações\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/animation-basics/pt/making-animations\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/animation-basics/pc/challenge-exploding-sun\",\"contentDescriptor\":\"Challenge:xdcd3b332d4fa1409\",\"contentKind\":\"Challenge\",\"id\":\"xdcd3b332d4fa1409\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3312fbc8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2050946856\",\"slug\":\"challenge-exploding-sun\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Faça o sol ficar cada vez MAIOR!\",\"translatedTitle\":\"Desafio: Explodindo o Sol\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/animation-basics/pc/challenge-exploding-sun\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/animation-basics/pt/incrementing-shortcuts\",\"contentDescriptor\":\"Talkthrough:x6ec9adc18c84f591\",\"contentKind\":\"Talkthrough\",\"id\":\"x6ec9adc18c84f591\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3312fbc8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6084559249211392\",\"slug\":\"incrementing-shortcuts\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela compartilha dicas sobre como alterar variáveis (como incrementá-las ou multiplicá-las) com menos código.\",\"translatedTitle\":\"Atalhos para incrementos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/animation-basics/pt/incrementing-shortcuts\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/animation-basics/pt/a-shorter-shortcut\",\"contentDescriptor\":\"Talkthrough:x8f57529281a3cf5c\",\"contentKind\":\"Talkthrough\",\"id\":\"x8f57529281a3cf5c\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3312fbc8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p4949440858161152\",\"slug\":\"a-shorter-shortcut\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como usar o operador ++ para somar um a uma variável.\",\"translatedTitle\":\"Um atalho mais curto\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/animation-basics/pt/a-shorter-shortcut\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/animation-basics/pc/challenge-parting-clouds\",\"contentDescriptor\":\"Challenge:x829eca528cb928da\",\"contentKind\":\"Challenge\",\"id\":\"x829eca528cb928da\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3312fbc8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2093483305\",\"slug\":\"challenge-parting-clouds\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Faça uma animação para que as nuvens se afastem do sol!\",\"translatedTitle\":\"Desafio: Afastando as Nuvens\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/animation-basics/pc/challenge-parting-clouds\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/animation-basics/pp/project-shooting-star\",\"contentDescriptor\":\"Project:xa7ff2accd92edf82\",\"contentKind\":\"Project\",\"id\":\"xa7ff2accd92edf82\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3312fbc8\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p4943271586693120\",\"slug\":\"project-shooting-star\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eAgora que você aprendeu os conceitos básicos de animação com variáveis, faça uma estrela cadente! Começamos esse programa com apenas uma estrela posicionada usando duas variáveis e agora você deve decidir como animá-la. Estas são as etapas que sugerimos:\\u003c/p\\u003e\\n\\u003col class=\\\"styled-list\\\"\\u003e\\n\\u003cli\\u003eDecida em qual lado da tela você quer que a estrela comece, a partir de cima, de baixo, da esquerda ou direita, e posicione sua estrela lá.\\u003c/li\\u003e\\n\\u003cli\\u003eDecida em qual direção você quer que a estrela se mova. Mude as variáveis dentro da função \\u003ccode\\u003edraw\\u003c/code\\u003e para que a estrela se mova da maneira que você quer.\\u003c/li\\u003e\\n\\u003cli\\u003eAdicione outra estrela ou forma, e faça com que ela vá em outra direção.\\u003c/li\\u003e\\n\\u003cli\\u003eBônus: transforme a estrela em uma forma diferente, ou faça com que ela seja lançada de um canhão.\\u003c/li\\u003e\\n\\u003cli\\u003eBônus: adicione um plano de fundo, como uma noite estrelada ou prédios.\\u003c/li\\u003e\\n\\n\\u003c/ol\\u003e\\n\",\"translatedTitle\":\"Projeto: estrela cadente\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/animation-basics/pp/project-shooting-star\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x3312fbc8\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgzMzEyZmJjOAw\",\"relativeUrl\":\"/computing/computer-programming/programming/animation-basics\",\"slug\":\"animation-basics\",\"translatedDescription\":\"Aprenda a animar seus desenhos.\",\"translatedTitle\":\"Conceitos básicos de Animação\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/interactive-programs/pt/mouse-interaction\",\"contentDescriptor\":\"Talkthrough:x9a7bec6252eb80ad\",\"contentKind\":\"Talkthrough\",\"id\":\"x9a7bec6252eb80ad\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x1ea6ab23\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p4831472609918976\",\"slug\":\"mouse-interaction\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica como usar mouseX e mouseY para criar programas interativos divertidos.\",\"translatedTitle\":\"Interação com o Mouse\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/interactive-programs/pt/mouse-interaction\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/interactive-programs/pc/challenge-tasty-tomato\",\"contentDescriptor\":\"Challenge:xaf99700557d4da18\",\"contentKind\":\"Challenge\",\"id\":\"xaf99700557d4da18\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x1ea6ab23\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2063745173\",\"slug\":\"challenge-tasty-tomato\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Com fome? Coma o tomate!\",\"translatedTitle\":\"Desafio: O Tomate Saboroso\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/interactive-programs/pc/challenge-tasty-tomato\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/interactive-programs/pc/challenge-mouse-movement-mania\",\"contentDescriptor\":\"Challenge:xa54865e772c53634\",\"contentKind\":\"Challenge\",\"id\":\"xa54865e772c53634\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x1ea6ab23\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5018383753412608\",\"slug\":\"challenge-mouse-movement-mania\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: mouse maluco\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/interactive-programs/pc/challenge-mouse-movement-mania\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x1ea6ab23\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgxZWE2YWIyMww\",\"relativeUrl\":\"/computing/computer-programming/programming/interactive-programs\",\"slug\":\"interactive-programs\",\"translatedDescription\":\"Aprenda a criar programas que desenham formas com base na posição do mouse, como aplicativos de desenho.\",\"translatedTitle\":\"Programas interativos\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/resizing-with-variables/a/using-math-expressions-in-js\",\"contentDescriptor\":\"Article:xe92b9d1d\",\"contentKind\":\"Article\",\"id\":\"xe92b9d1d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x42259a14\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"axe92b9d1d\",\"slug\":\"using-math-expressions-in-js\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Usando expressões matemáticas em JS\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/resizing-with-variables/a/using-math-expressions-in-js\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/resizing-with-variables/pt/resizing-shapes-with-variable-expressions\",\"contentDescriptor\":\"Talkthrough:xa724ba7def511016\",\"contentKind\":\"Talkthrough\",\"id\":\"xa724ba7def511016\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x42259a14\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6658231843815424\",\"slug\":\"resizing-shapes-with-variable-expressions\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Aprenda a redimensionar formas entre si proporcionalmente com frações e expressões variáveis.\",\"translatedTitle\":\"Redimensionando formas com expressões variáveis\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/resizing-with-variables/pt/resizing-shapes-with-variable-expressions\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/programming/resizing-with-variables/e/quiz--use-variable-expressions\",\"contentDescriptor\":\"Exercise:xaae103de\",\"contentKind\":\"Exercise\",\"exerciseLength\":6,\"id\":\"xaae103de\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x42259a14\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"exaae103de\",\"slug\":\"quiz--use-variable-expressions\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":6,\"upperBound\":9},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Uso de expressões variáveis\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/resizing-with-variables/e/quiz--use-variable-expressions\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/resizing-with-variables/pc/challenge-brown-bear-eyes\",\"contentDescriptor\":\"Challenge:xb911e7f4f807ac3f\",\"contentKind\":\"Challenge\",\"id\":\"xb911e7f4f807ac3f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x42259a14\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5470148512972800\",\"slug\":\"challenge-brown-bear-eyes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Os olhos do urso pardo\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/resizing-with-variables/pc/challenge-brown-bear-eyes\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/resizing-with-variables/pp/project-animal-attack\",\"contentDescriptor\":\"Project:x3fd2069765dc1464\",\"contentKind\":\"Project\",\"id\":\"x3fd2069765dc1464\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x42259a14\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5069965890945024\",\"slug\":\"project-animal-attack\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eVocê fez vários animais nos desafios de programação com variáveis - um coelho, um urso, um sapo. Que outros animais você pode fazer com formas e variáveis?\\u003c/p\\u003e\\n\\n\\u003cp\\u003eFaça um animal usando os comandos de desenho e use variáveis para os números que você passa para os comandos, como no código inicial abaixo. Você também deve usar variáveis para qualquer informação repetida sobre seu animal, como o tamanho dos olhos, para que você possa alterar o tamanho de ambos os olhos de uma só vez.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eFeito isso, escolha uma variável para animar - talvez deixar a face do animal maior, ou fazer um dos olhos ficar esbugalhado - esse é o ataque! Cuidado, seus programas estão atrás de você agora. :)\\u003c/p\\u003e\\n \\n\",\"translatedTitle\":\"Projeto: ataque animal\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/resizing-with-variables/pp/project-animal-attack\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x42259a14\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg0MjI1OWExNAw\",\"relativeUrl\":\"/computing/computer-programming/programming/resizing-with-variables\",\"slug\":\"resizing-with-variables\",\"translatedDescription\":\"Aprenda a usar expressões variáveis para redimensionar partes do seu desenho com relação a outras partes. Note que isso exige um pouco mais de matemática, então se você sentir que ainda não compreende bem as frações, você pode pular essa parte.\",\"translatedTitle\":\"Bônus: redimensionamento com variáveis\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/text-basics/pt/terrific-text-part-one\",\"contentDescriptor\":\"Talkthrough:x3f3dfd07de099bfb\",\"contentKind\":\"Talkthrough\",\"id\":\"x3f3dfd07de099bfb\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xb0180d93\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p1887214592\",\"slug\":\"terrific-text-part-one\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Sophia mostra como exibir o texto na tela, além de alterar seu tamanho e sua cor.\",\"translatedTitle\":\"Texto Fabuloso: Parte Um\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/text-basics/pt/terrific-text-part-one\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/text-basics/pc/challenge-my-favorite-foods\",\"contentDescriptor\":\"Challenge:x05f765eb07d3c46c\",\"contentKind\":\"Challenge\",\"id\":\"x05f765eb07d3c46c\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xb0180d93\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2073015346\",\"slug\":\"challenge-my-favorite-foods\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Faça uma lista com o que você mais gosta\",\"translatedTitle\":\"Desafio: Minhas Comidas Favoritas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/text-basics/pc/challenge-my-favorite-foods\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/text-basics/pt/terrific-text-part-two\",\"contentDescriptor\":\"Talkthrough:x537afb011ba0c656\",\"contentKind\":\"Talkthrough\",\"id\":\"x537afb011ba0c656\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xb0180d93\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p1887341917\",\"slug\":\"terrific-text-part-two\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Sofia introduz o conceito de \\\"strings\\\", que são cadeias de caracteres, e mostra como armazená-las em variáveis e exibi-las através de comandos de texto.\",\"translatedTitle\":\"Texto Fabuloso: Parte Dois\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/text-basics/pt/terrific-text-part-two\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/text-basics/pc/challenge-mouse-tracker\",\"contentDescriptor\":\"Challenge:x961035a18e528856\",\"contentKind\":\"Challenge\",\"id\":\"x961035a18e528856\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xb0180d93\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2072888717\",\"slug\":\"challenge-mouse-tracker\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Rastreie a posição do mouse\",\"translatedTitle\":\"Desafio: Rastreador de Mouse\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/text-basics/pc/challenge-mouse-tracker\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/text-basics/a/review-text-and-strings\",\"contentDescriptor\":\"Article:x4fe57463\",\"contentKind\":\"Article\",\"id\":\"x4fe57463\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xb0180d93\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax4fe57463\",\"slug\":\"review-text-and-strings\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Revisão: texto e strings\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/text-basics/a/review-text-and-strings\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/text-basics/pp/project-ad-design\",\"contentDescriptor\":\"Project:xb975d51de8451b9f\",\"contentKind\":\"Project\",\"id\":\"xb975d51de8451b9f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xb0180d93\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2531560726\",\"slug\":\"project-ad-design\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eNos desafios de texto, você mostrou que sabe como usar os comados de texto. Agora use esse conhecimento para fazer um anúncio para um produto real ou imaginário!\\u003c/p\\u003e\\n\\u003col class=\\\"styled-list\\\"\\u003e\\n  \\u003cli\\u003eAltere o título grande para o nome do seu produto.\\u003c/li\\u003e\\n  \\u003cli\\u003eInclua pelo menos mais duas funções de texto para anunciar o seu produto\\u003c/li\\u003e\\n  \\u003cli\\u003eMude o tamanho do texto pra usar pelo menos 3 tamanhos diferentes.\\u003c/li\\u003e\\n  \\u003cli\\u003eInclua um desenho com pelo menos 3 formas ou chamadas de funções de imagem.\\u003c/li\\u003e\\n  \\u003cli\\u003eBônus: Brinque com as cores e posicionamento para dar mais destaque. Se quiser, acrescente uma animação!\\u003c/li\\u003e\\n\\u003c/ol\\u003e\",\"translatedTitle\":\"Projeto: Anúncio Publicitário\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/text-basics/pp/project-ad-design\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"xb0180d93\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhiMDE4MGQ5Mww\",\"relativeUrl\":\"/computing/computer-programming/programming/text-basics\",\"slug\":\"text-basics\",\"translatedDescription\":\"Aprenda a exibir o texto na tela, a redimensioná-lo, colori-lo e animá-lo.\",\"translatedTitle\":\"Texto e strings\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pt/functions\",\"contentDescriptor\":\"Talkthrough:x454da486686fffe5\",\"contentKind\":\"Talkthrough\",\"id\":\"x454da486686fffe5\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2143079864\",\"slug\":\"functions\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica como escrever suas próprias funções para organizar seu código e deixá-lo mais reutilizável. \",\"translatedTitle\":\"Funções\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pt/functions\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pc/challenge-say-your-name\",\"contentDescriptor\":\"Challenge:x5a0fcfe0f25b3156\",\"contentKind\":\"Challenge\",\"id\":\"x5a0fcfe0f25b3156\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2144527253\",\"slug\":\"challenge-say-your-name\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Diga o seu Nome\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pc/challenge-say-your-name\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pt/function-parameters\",\"contentDescriptor\":\"Talkthrough:x75955f9139e776a3\",\"contentKind\":\"Talkthrough\",\"id\":\"x75955f9139e776a3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2143920476\",\"slug\":\"function-parameters\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como você pode passar parâmetros para as funções, de forma que elas tenham um comportamento diferente a cada vez que você as chamar.\",\"translatedTitle\":\"Parâmetros das Funções\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pt/function-parameters\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pc/challenge-moles-in-holes\",\"contentDescriptor\":\"Challenge:x640ea7b6ce9763d0\",\"contentKind\":\"Challenge\",\"id\":\"x640ea7b6ce9763d0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2144527285\",\"slug\":\"challenge-moles-in-holes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Toupeiras nos Buracos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pc/challenge-moles-in-holes\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pt/function-return-values\",\"contentDescriptor\":\"Talkthrough:x029b2c8baa2576d7\",\"contentKind\":\"Talkthrough\",\"id\":\"x029b2c8baa2576d7\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2144066883\",\"slug\":\"function-return-values\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica como retornar valores nas funções, o que é muito útil principalmente para fazer cálculos.\",\"translatedTitle\":\"Retorno de Valores em Funções\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pt/function-return-values\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pc/challenge-calculator\",\"contentDescriptor\":\"Challenge:x98f04c1e810db770\",\"contentKind\":\"Challenge\",\"id\":\"x98f04c1e810db770\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2144057841\",\"slug\":\"challenge-calculator\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Calculadora\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pc/challenge-calculator\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pt/local-and-global-variables\",\"contentDescriptor\":\"Talkthrough:x04aaaa495eaa7648\",\"contentKind\":\"Talkthrough\",\"id\":\"x04aaaa495eaa7648\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2158089816\",\"slug\":\"local-and-global-variables\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica a diferença entre variáveis \\\"locais\\\"e \\\"globais\\\" um conceito complicado na programação.\",\"translatedTitle\":\"Variáveis Locais e Globais\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pt/local-and-global-variables\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pt/special-processingjs-functions\",\"contentDescriptor\":\"Talkthrough:x1c85c094801bf390\",\"contentKind\":\"Talkthrough\",\"id\":\"x1c85c094801bf390\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5076945701306368\",\"slug\":\"special-processingjs-functions\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica as funções especiais predefinidas em ProcessingJS que usamos para desenhar e interagir, como `draw()` e `mouseMoved()`.\",\"translatedTitle\":\"Funções especiais de ProcessingJS\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pt/special-processingjs-functions\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/a/review-functions\",\"contentDescriptor\":\"Article:x81428b6b\",\"contentKind\":\"Article\",\"id\":\"x81428b6b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax81428b6b\",\"slug\":\"review-functions\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Revisão: Funções\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/a/review-functions\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/functions/pp/project-fish-tank\",\"contentDescriptor\":\"Project:xb2330406c4b06c52\",\"contentKind\":\"Project\",\"id\":\"xb2330406c4b06c52\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xc4ab8747\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6136673667645440\",\"slug\":\"project-fish-tank\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003e\\nEste programa desenha apenas um peixe. Pobre peixe solitário! Neste projeto você vai usar funções para criar mais peixes de formas e cores diferentes pra fazer companhia para ele.\\n\\u003c/p\\u003e\\n\\u003col class=\\\"styled-list\\\"\\u003e\\n\\u003cli\\u003eCrie uma função personalizada (por exemplo,  \\u003ccode\\u003edrawFish\\u003c/code\\u003e) que desenhe um peixe. Você pode usar um código como base ou começar do zero.\\u003c/li\\u003e\\n\\u003cli\\u003eAdicione pelo menos dois parâmetros na declaração da função que controlem ou a posição ou o tamanho do peixe.\\u003c/li\\u003e\\n\\u003cli\\u003eAgora chame essa função várias vezes, com argumentos diferentes, para que sua tela fique cheia de peixes.\\u003c/li\\u003e\\n\\u003cli\\u003eBônus: Adicione mais parâmetros na declaração da função, como cor, tamanho do rabo, tamanho dos olhos, cor do rabo—outras maneiras de tornar um peixe diferente do outro.\\u003c/li\\u003e\\n\\u003cli\\u003eBônus: Acrescente algas marinhas ao aquário, pedriscos no fundo, ou bolhas flutuando para cima. Para qualquer objeto que você incluir, crie uma função para desenhá-lo em posições diferenres.\\u003c/li\\u003e\\n \\u003cli\\u003eBônus: Quer tornar o programa interativo? Use a função  \\u003ccode\\u003emouseClicked\\u003c/code\\u003e para incluir mais peices sempre que o usuário clicar.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\n\\u003cp\\u003eNão gosta de peixes? Você pode desenhar uma coleção de gatos ou carros diferentes. O importante é criar funções para que seu código seja reusável.\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: Aquário\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/functions/pp/project-fish-tank\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"xc4ab8747\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhjNGFiODc0Nww\",\"relativeUrl\":\"/computing/computer-programming/programming/functions\",\"slug\":\"functions\",\"translatedDescription\":\"Torne seu código mais reutilizável dividindo-o em funções, e então faça com que as funções aceitem parâmetros e retornem valores.\",\"translatedTitle\":\"Funções\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/pt/if-statements\",\"contentDescriptor\":\"Talkthrough:x23c9d7b0aa3242d5\",\"contentKind\":\"Talkthrough\",\"id\":\"x23c9d7b0aa3242d5\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p836708402\",\"slug\":\"if-statements\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Jéssica faz uma introdução às estruturas condicionais, uma forma do programa decidir quando ele deve ou não deve executar um bloco de código.\",\"translatedTitle\":\"Estruturas condicionais If\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/pt/if-statements\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/pt/more-mouse-interaction\",\"contentDescriptor\":\"Talkthrough:xd5d9877121463771\",\"contentKind\":\"Talkthrough\",\"id\":\"xd5d9877121463771\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2032823940\",\"slug\":\"more-mouse-interaction\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica como usar a função mouseIsPressed com estruturas if para executar o código apenas quando o usuário está pressionando o botão do mouse.\",\"translatedTitle\":\"Mais Interações com o Mouse\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/pt/more-mouse-interaction\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/pt/booleans\",\"contentDescriptor\":\"Talkthrough:x1c4f3dc7725c034b\",\"contentKind\":\"Talkthrough\",\"id\":\"x1c4f3dc7725c034b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p839898911\",\"slug\":\"booleans\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Jéssica introduz o conceito de \\\"booleanos\\\", valores que ou são  verdadeiro ou falso.\",\"translatedTitle\":\"Booleanos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/pt/booleans\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/pc/challenge-number-analyzer\",\"contentDescriptor\":\"Challenge:x74fb643f25738091\",\"contentKind\":\"Challenge\",\"id\":\"x74fb643f25738091\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2156959944\",\"slug\":\"challenge-number-analyzer\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Analisador de Números\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/pc/challenge-number-analyzer\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/pt/logical-operators\",\"contentDescriptor\":\"Talkthrough:x20d6ef5e5dbc83ee\",\"contentKind\":\"Talkthrough\",\"id\":\"x20d6ef5e5dbc83ee\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2113898254\",\"slug\":\"logical-operators\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como usar diferentes operadores lógicos (como \\u0026\\u0026 e ||) dentro de estruturas if.\",\"translatedTitle\":\"Operadores lógicos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/pt/logical-operators\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/pt/ifelse-part-1\",\"contentDescriptor\":\"Talkthrough:x3bc92b11f8d381d9\",\"contentKind\":\"Talkthrough\",\"id\":\"x3bc92b11f8d381d9\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p986012057\",\"slug\":\"ifelse-part-1\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Jéssica introduz a alma gêmea do if: o else.\",\"translatedTitle\":\"If/Else - Parte 1\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/pt/ifelse-part-1\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/pt/ifelse-part-2\",\"contentDescriptor\":\"Talkthrough:xdc414fbe01b7f0d0\",\"contentKind\":\"Talkthrough\",\"id\":\"xdc414fbe01b7f0d0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p985924758\",\"slug\":\"ifelse-part-2\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Jéssica mostra como deixar suas estruturas condicionais mais poderosas usando \\\"if/else\\\".\",\"translatedTitle\":\"If/Else - Parte 2\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/pt/ifelse-part-2\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/a/review-logic-and-if-statements\",\"contentDescriptor\":\"Article:x4a899dc9\",\"contentKind\":\"Article\",\"id\":\"x4a899dc9\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax4a899dc9\",\"slug\":\"review-logic-and-if-statements\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Revisão: Lógica e Instruções if\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/a/review-logic-and-if-statements\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/a/checking-random-numbers\",\"contentDescriptor\":\"Article:x9d1ee5af504392b5\",\"contentKind\":\"Article\",\"id\":\"x9d1ee5af504392b5\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax9d1ee5af504392b5\",\"slug\":\"checking-random-numbers\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Aprenda como gerar números aleatórios no ProcessingJS usando a função random(), e cheque seus valores usando a estrutura condicional if.\",\"translatedTitle\":\"Números aleatórios\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/a/checking-random-numbers\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/logic-if-statements/pp/project-magic-8-ball\",\"contentDescriptor\":\"Project:x93afb4bb1096e189\",\"contentKind\":\"Project\",\"id\":\"x93afb4bb1096e189\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x7323ca45\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2545987231\",\"slug\":\"project-magic-8-ball\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eVocê já brincou com uma Bola 8 Mágica? É um brinquedo que mostra uma mensagem aleatória cada vez que você o chacoalha, por exemplo: \\\"Com certeza\\\" ou \\\"Minhas fontes dizem que não\\\". Neste projeto você vai criar a sua própria bola mágica usando comandos  if/else, para que seu programa possa responder suas mais profundas questões sobre a vida.\\u003c/p\\u003e\\n\\u003col class=\\\"styled-list\\\"\\u003e\\n \\u003cli\\u003eMude o \\u003ccode\\u003eif()\\u003c/code\\u003e para verificar se a variável \\u003ccode\\u003eanswer\\u003c/code\\u003e (resposta) tem um determinado número e mude o texto da mensagem inicial.\\u003cbr\\u003e\\u003cem\\u003eDica: Clique em Reiniciar até que apareça a mensagem.\\u003c/em\\u003e\\u003c/li\\u003e\\n  \\u003cli\\u003eAcrescente os \\u003ccode\\u003eelse if()\\u003c/code\\u003e para verificar todos os possíveis valores da variável \\u003ccode\\u003eanswer\\u003c/code\\u003e, e mostre uma mensagem diferente para cada valor. \\u003cbr\\u003e\\u003cem\\u003eDica: Para facilitar os testes para valores específicos, você pode acrescentar uma linha do tipo \\u003ccode\\u003evar answer = 1\\u003c/code\\u003e abaixo da linha que gera os números aleatórios, e então clicar Reiniciar para testar. Lembre-se de apagar essa linha auxiliar antes de enviar o projeto para avaliação.\\u003c/em\\u003e\\u003c/li\\u003e\\n  \\u003cli\\u003eBonus: Dê a cada mensagem um jeito diferente, mudando a cor, incluindo imagens ou mudando o estilo do texto. Há vários comandos de texto na documentação que você pode usar!\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eVocê pode brincar com os números da função  \\u003ccode\\u003efloor(random(1, 5))\\u003c/code\\u003e desde que você tenha pelo menos 3 valores possíveis para a variável answer (resposta), mas não remova  \\u003ccode\\u003efloor()\\u003c/code\\u003e ou \\u003ccode\\u003erandom()\\u003c/code\\u003e. A combinação é a melhor maneira de criar uma distribuição estatística de valores razoavelmente equilibrada. Para entender o porquê, releia o artigo \\u003ca href=\\\"computing/computer-programming/programming/logic-if-statements/a/checking-random-numbers\\\"\\u003eNúmeros aleatórios\\u003c/a\\u003e.\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: A Bola 8 Mágica\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/logic-if-statements/pp/project-magic-8-ball\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x7323ca45\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg3MzIzY2E0NQw\",\"relativeUrl\":\"/computing/computer-programming/programming/logic-if-statements\",\"slug\":\"logic-if-statements\",\"translatedDescription\":\"Ensine seu programa a tomar decisões!\",\"translatedTitle\":\"Lógica e estruturas condicionais if\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/debugging-programs/pt/debugging-with-printlns\",\"contentDescriptor\":\"Talkthrough:x8a6cf101071170a3\",\"contentKind\":\"Talkthrough\",\"id\":\"x8a6cf101071170a3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xbdc5ca9e\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6644173996425216\",\"slug\":\"debugging-with-printlns\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Depuração com comandos println()\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/debugging-programs/pt/debugging-with-printlns\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/debugging-programs/a/more-debugging-tips\",\"contentDescriptor\":\"Article:xb43537b0\",\"contentKind\":\"Article\",\"id\":\"xb43537b0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xbdc5ca9e\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"axb43537b0\",\"slug\":\"more-debugging-tips\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Mais dicas de depuração\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/debugging-programs/a/more-debugging-tips\"}],\"id\":\"xbdc5ca9e\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhiZGM1Y2E5ZQw\",\"relativeUrl\":\"/computing/computer-programming/programming/debugging-programs\",\"slug\":\"debugging-programs\",\"translatedDescription\":\"Como você pode descobrir o que há de errado com seu código? Aprenda dicas e truques para depurar seus programas.\",\"translatedTitle\":\"Depuração de programas\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/pt/intro-to-while-loops\",\"contentDescriptor\":\"Talkthrough:x7e459f59f964cb40\",\"contentKind\":\"Talkthrough\",\"id\":\"x7e459f59f964cb40\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2081388243\",\"slug\":\"intro-to-while-loops\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Sophia mostra como fazer a repetição do código no seu programa, usando laços while.\",\"translatedTitle\":\"Introdução aos laços de repetição While\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/pt/intro-to-while-loops\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/e/review-loops\",\"contentDescriptor\":\"Exercise:x7cde8e67\",\"contentKind\":\"Exercise\",\"exerciseLength\":6,\"id\":\"x7cde8e67\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ex7cde8e67\",\"slug\":\"review-loops\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":6,\"upperBound\":9},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Usando laços while\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/e/review-loops\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/pc/challenge-a-loopy-ruler\",\"contentDescriptor\":\"Challenge:x6967d881df9eb989\",\"contentKind\":\"Challenge\",\"id\":\"x6967d881df9eb989\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2145303404\",\"slug\":\"challenge-a-loopy-ruler\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Uma Régua com Repetição\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/pc/challenge-a-loopy-ruler\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/pt/more-while-loops-balloon-hopper\",\"contentDescriptor\":\"Talkthrough:xb2a413655fa1d068\",\"contentKind\":\"Talkthrough\",\"id\":\"xb2a413655fa1d068\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2785233642\",\"slug\":\"more-while-loops-balloon-hopper\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Sophia mostra como usar um laço while para desenhar várias formas em sequência.\",\"translatedTitle\":\"Mais Laços While: Um Monte de Balões\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/pt/more-while-loops-balloon-hopper\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/pt/for-loops-a-new-kind-of-loop\",\"contentDescriptor\":\"Talkthrough:xaffb6da8f4264d88\",\"contentKind\":\"Talkthrough\",\"id\":\"xaffb6da8f4264d88\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6684386237874176\",\"slug\":\"for-loops-a-new-kind-of-loop\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Laços For! Um novo tipo de Estrutura de Repetição\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/pt/for-loops-a-new-kind-of-loop\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/pc/challenge-lined-paper\",\"contentDescriptor\":\"Challenge:xfd60ea0ee3751ee2\",\"contentKind\":\"Challenge\",\"id\":\"xfd60ea0ee3751ee2\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5047809057226752\",\"slug\":\"challenge-lined-paper\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Folha com Linhas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/pc/challenge-lined-paper\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/pt/nested-for-loops\",\"contentDescriptor\":\"Talkthrough:xa0cd96d0895e1e3d\",\"contentKind\":\"Talkthrough\",\"id\":\"xa0cd96d0895e1e3d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p4838213478776832\",\"slug\":\"nested-for-loops\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica como usar laços for aninhados para estruturas de repetição mais complexas.\",\"translatedTitle\":\"Laços For Aninhados\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/pt/nested-for-loops\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/a/review-looping\",\"contentDescriptor\":\"Article:xcf1d241d\",\"contentKind\":\"Article\",\"id\":\"xcf1d241d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"axcf1d241d\",\"slug\":\"review-looping\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Revisão: Repetições\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/a/review-looping\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/looping/pp/project-build-a-house\",\"contentDescriptor\":\"Project:x5cffda235469fa88\",\"contentKind\":\"Project\",\"id\":\"x5cffda235469fa88\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2f8e35eb\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5322961523310592\",\"slug\":\"project-build-a-house\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003ePense na sua casa, apartamento, escola ou escritório. Há muitos elementos que se repetem, especialmente no lado de fora. Neste projeto você vai usar loops para incluir elementos repetitivos nesta casa. Passos sugeridos\\u003c/p\\u003e\\n\\u003col class=\\\"styled-list\\\"\\u003e\\n \\u003cli\\u003eDesenhe uma janela, então use um loop for para desenhar uma fileira de janelas (ou, use loops for alinhados para desenhar várias linhas de janelas).\\u003c/li\\u003e\\n \\u003cli\\u003eDesenhe um gramado na frente. E talvez alguns arbustos ou flores?\\u003c/li\\u003e\\n \\u003cli\\u003eA casa tem só uma cor. Use loops para fazer uma casa de tijolos ou uma cabana de madeira. Cheque \\u003ca href=\\\"/computer-programming/imageimage-x-y/937672662\\\" target=\\\"_blank\\\"\\u003eimages library\\u003c/a\\u003e para ver maneiras de fazer isso parecer real.\\u003c/li\\u003e\\n \\u003cli\\u003eBônus: Use um conditional dentro de um loop for para fazer um gramado ou pintura com aparência mais real (dica: use \\u003ca href=\\\"/computer-programming/the-operator/6698198968041472\\\" target=\\\"_blank\\\"\\u003e% operator\\u003c/a\\u003e).\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eContinue! O que mais você pode desenhar com loops?\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: Construindo uma Casa\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/looping/pp/project-build-a-house\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x2f8e35eb\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgyZjhlMzVlYgw\",\"relativeUrl\":\"/computing/computer-programming/programming/looping\",\"slug\":\"looping\",\"translatedDescription\":\"Precisa repetir alguma coisa várias vezes? Os laços estão aqui para ajudar!\",\"translatedTitle\":\"Repetições\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/writing-clean-code/pt/readable-code\",\"contentDescriptor\":\"Talkthrough:x8388fd9840064696\",\"contentKind\":\"Talkthrough\",\"id\":\"x8388fd9840064696\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2087c5d4\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2048804437\",\"slug\":\"readable-code\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra a diferença entre código ilegível e código legível. Opte pelo legível!\",\"translatedTitle\":\"Código Legível\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/writing-clean-code/pt/readable-code\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/writing-clean-code/pt/clarifying-with-comments\",\"contentDescriptor\":\"Talkthrough:x3ac6586386af570b\",\"contentKind\":\"Talkthrough\",\"id\":\"x3ac6586386af570b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2087c5d4\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p1981573965\",\"slug\":\"clarifying-with-comments\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela te encoraja a usar comentários para deixar seu código mais claro, legível, e fácil de entender.\",\"translatedTitle\":\"Explicando com Comentários\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/writing-clean-code/pt/clarifying-with-comments\"}],\"id\":\"x2087c5d4\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgyMDg3YzVkNAw\",\"relativeUrl\":\"/computing/computer-programming/programming/writing-clean-code\",\"slug\":\"writing-clean-code\",\"translatedDescription\":\"Aprenda a codificar em JavaScript de forma fácil de ler e entender, fazendo bom uso da identação, do espaçamento, da nomeação e dos comentários.\",\"translatedTitle\":\"Escrevendo um código limpo\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/arrays/pt/intro-to-arrays\",\"contentDescriptor\":\"Talkthrough:x433ebed38207f3a6\",\"contentKind\":\"Talkthrough\",\"id\":\"x433ebed38207f3a6\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x54f8c602\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2152694739\",\"slug\":\"intro-to-arrays\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela faz uma introdução aos arrays, uma forma elegante de armazenar uma sequência de vários valores em uma variável.\",\"translatedTitle\":\"Introdução aos Arrays\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/arrays/pt/intro-to-arrays\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/arrays/pc/challenge-favorite-fruits\",\"contentDescriptor\":\"Challenge:x73f607d9275bdabc\",\"contentKind\":\"Challenge\",\"id\":\"x73f607d9275bdabc\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x54f8c602\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2243790989\",\"slug\":\"challenge-favorite-fruits\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Frutas Favoritas\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/arrays/pc/challenge-favorite-fruits\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/arrays/pt/looping-through-arrays\",\"contentDescriptor\":\"Talkthrough:x787a9afbae038c01\",\"contentKind\":\"Talkthrough\",\"id\":\"x787a9afbae038c01\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x54f8c602\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2153938073\",\"slug\":\"looping-through-arrays\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica como usar laços de repetição para percorrer cada valor em um array.\",\"translatedTitle\":\"Estruturas de Repetição em Arrays\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/arrays/pt/looping-through-arrays\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/arrays/pt/modifying-arrays\",\"contentDescriptor\":\"Talkthrough:xb63f0a393a23901b\",\"contentKind\":\"Talkthrough\",\"id\":\"xb63f0a393a23901b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x54f8c602\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2158868138\",\"slug\":\"modifying-arrays\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como modificar um array enquanto seu programa está em execução, para adicionar ou alterar valores.\",\"translatedTitle\":\"Modificando Arrays\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/arrays/pt/modifying-arrays\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/arrays/pc/challenge-constellation-maker\",\"contentDescriptor\":\"Challenge:x665b905e6f644096\",\"contentKind\":\"Challenge\",\"id\":\"x665b905e6f644096\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x54f8c602\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5967673208864768\",\"slug\":\"challenge-constellation-maker\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Fábrica de Constelações\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/arrays/pc/challenge-constellation-maker\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/arrays/a/review-arrays\",\"contentDescriptor\":\"Article:xee3da0df\",\"contentKind\":\"Article\",\"id\":\"xee3da0df\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x54f8c602\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"axee3da0df\",\"slug\":\"review-arrays\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Revisão: Arrays\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/arrays/a/review-arrays\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/arrays/pp/project-make-it-rain\",\"contentDescriptor\":\"Project:x49acc315102eedfd\",\"contentKind\":\"Project\",\"id\":\"x49acc315102eedfd\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x54f8c602\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6644170649239552\",\"slug\":\"project-make-it-rain\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003ePara fazer uma animação de chuva, é melhor usar arrays (vetores) para acompanhar as gotas de chuva e suas propriedades. Comece com este código simples e vá evoluindo para fazer uma animação bem legal.\\u003c/p\\u003e\\n\\u003col class=\\\"styled-list\\\"\\u003e\\n \\u003cli\\u003eAcrescente mais gotas aos arrays. Você pode fazer isso usando um loop \\u003ccode\\u003efor\\u003c/code\\u003e e a função  \\u003ccode\\u003erandom()\\u003c/code\\u003e no começo do programa, ou usar um método de modificar o array durante a animação. Você pode até acrescentar mais gotas em resposta a uma interação do usuário.\\n \\u003cli\\u003eFaça chover de forma contínua alterando a posição de cada gota quando ela chegar a um dos lados da tela, usando um condicional ou \\u003ca href=\\\"/cs/the-operator/6698198968041472\\\" target=\\\"_blank\\\"\\u003e% operator\\u003c/a\\u003e.\\n \\u003cli\\u003eBônus: Faça um array de cores, para que cada gota tenha uma cor diferente, ou um array de velocidades.\\n \\u003cli\\u003eBônus: Faça chover outras coisas, como flocos de neve (usando outros comandos de formas) ou avatares (usando comandos de imagem). Se você usar múltiplos comandos para desenhar qualquer coisa caindo, considere criar uma função personalizada com parâmetros.\\n\\u003c/ol\\u003e\",\"translatedTitle\":\"Projeto: Faça Chover\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/arrays/pp/project-make-it-rain\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x54f8c602\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg1NGY4YzYwMgw\",\"relativeUrl\":\"/computing/computer-programming/programming/arrays\",\"slug\":\"arrays\",\"translatedDescription\":\"Armazene múltiplos valores em suas variáveis usando arrays!\",\"translatedTitle\":\"Arrays\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/objects/pt/intro-to-objects\",\"contentDescriptor\":\"Talkthrough:x0de16b9f4bcff77b\",\"contentKind\":\"Talkthrough\",\"id\":\"x0de16b9f4bcff77b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x611e8e74\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2303521461\",\"slug\":\"intro-to-objects\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela introduz os objetos, uma maneira de armazenar várias propriedades em uma única variável.\",\"translatedTitle\":\"Introdução a Objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/objects/pt/intro-to-objects\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/objects/pt/modifying-objects\",\"contentDescriptor\":\"Talkthrough:xf3346317097dc514\",\"contentKind\":\"Talkthrough\",\"id\":\"xf3346317097dc514\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x611e8e74\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2324527100\",\"slug\":\"modifying-objects\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como modificar objetos enquanto seu programa está em execução, para alterar as propriedades existentes ou adicionar novas.\",\"translatedTitle\":\"Modificando Objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/objects/pt/modifying-objects\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/objects/pt/arrays-of-objects\",\"contentDescriptor\":\"Talkthrough:x3d4e926bc5cce131\",\"contentKind\":\"Talkthrough\",\"id\":\"x3d4e926bc5cce131\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x611e8e74\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2330727562\",\"slug\":\"arrays-of-objects\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como armazenar arrays de objetos - uma ferramenta muito poderosa para os seus programas.\",\"translatedTitle\":\"Arrays de Objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/objects/pt/arrays-of-objects\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/objects/a/review-objects\",\"contentDescriptor\":\"Article:x97439a8f\",\"contentKind\":\"Article\",\"id\":\"x97439a8f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x611e8e74\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax97439a8f\",\"slug\":\"review-objects\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Revisão: Objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/objects/a/review-objects\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming/objects/pp/project-bookshelf\",\"contentDescriptor\":\"Project:x02524899d605c3ed\",\"contentKind\":\"Project\",\"id\":\"x02524899d605c3ed\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x611e8e74\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6657335518822400\",\"slug\":\"project-bookshelf\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eWQuais são seus livros favoritos? Faça uma estante deles!\\u003c/p\\u003e\\u003col class=\\\"styled-list\\\"\\u003e\\u003cli\\u003e\\nEste programa mostra apenas um livro. Faça uma array de livros (com pelo menos dois deles), e use um loop para mostrar uma fileira deles.\\u003c/li\\u003e\\n \\u003cli\\u003eAdicione pelo menos uma propriedade para cada livro (por exemplo, Autor), e a mostre no livro.\\u003c/li\\u003e\\n \\u003cli\\u003eBônus: Adicione uma nova propriedade em cada objeto para armazenar uma cor, utilizando o comando \\u003ccode\\u003ecolor\\u003c/code\\u003e para preencher cada livro com diferentes cores. (Ou talvez armazene uma imagem?)\\u003c/li\\u003e\\n \\u003cli\\u003eAdicione uma propriedade booleana a cada livro (por exemplo, se você recomendaria o livro para um amigo ), e utilize uma condicional dentro do loop para desenhar alguma coisa diferente dependendo se a booleana for verdadeira ou falsa.\\u003c/li\\u003e\\n \\u003cli\\u003eBônus: Agora adicione mais prateleiras na tela e as encha de livros. Pense em como você poderia utilizar condicionais e/ou o operador \\u003ca href=\\\"/computer-programming/the-operator/6698198968041472\\\" target=\\\"_blank\\\"\\u003e para fazer essa tarefa.\\u003c/li\\u003e\\n\\u003c/ol\\u003eTodos os livros na prateleira devem mostrar visualmente pelo menos 3 propriedades.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\u003cp\\u003e\\u003cem\\u003eVocê não quer construir uma estante de livros? Você também pode fazer uma estante de vídeos ou vídeo games, ou recriar a tela inicial de seu smartphone.\\u003c/em\\u003e\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: Estante de Livros\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/objects/pp/project-bookshelf\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x611e8e74\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg2MTFlOGU3NAw\",\"relativeUrl\":\"/computing/computer-programming/programming/objects\",\"slug\":\"objects\",\"translatedDescription\":\"Aprenda a armazenar dados complexos em objetos.\",\"translatedTitle\":\"Objetos\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/object-oriented/pt/object-types\",\"contentDescriptor\":\"Talkthrough:xeaf751fa570ce17c\",\"contentKind\":\"Talkthrough\",\"id\":\"xeaf751fa570ce17c\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x9a11a504\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2771918371\",\"slug\":\"object-types\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela explica a primeira parte da programação orientada a objetos: a criação de tipos de objetos e de instâncias desses tipos.\",\"translatedTitle\":\"Tipos de Objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/object-oriented/pt/object-types\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/object-oriented/pc/challenge-double-rainbow\",\"contentDescriptor\":\"Challenge:x75ff09484b7dc0e0\",\"contentKind\":\"Challenge\",\"id\":\"x75ff09484b7dc0e0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x9a11a504\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p5918551070212096\",\"slug\":\"challenge-double-rainbow\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Crie um objeto do tipo Rainbow (arco-íris) que possa descrever os vários arco-íris pelo mundo.\",\"translatedTitle\":\"Desafio: Arco-íris em Dobro\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/object-oriented/pc/challenge-double-rainbow\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/object-oriented/pt/object-methods\",\"contentDescriptor\":\"Talkthrough:x1f8059d42c5394aa\",\"contentKind\":\"Talkthrough\",\"id\":\"x1f8059d42c5394aa\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x9a11a504\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2758453499\",\"slug\":\"object-methods\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como adicionar métodos aos tipos de objetos, os quais você pode chamar em qualquer instância do tipo de objeto.\",\"translatedTitle\":\"Métodos de Objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/object-oriented/pt/object-methods\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming/object-oriented/pc/challenge-smileyface\",\"contentDescriptor\":\"Challenge:x0a3d070bd19e1a2b\",\"contentKind\":\"Challenge\",\"id\":\"x0a3d070bd19e1a2b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x9a11a504\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p4689949351739392\",\"slug\":\"challenge-smileyface\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Crie um objeto SmileyFace (rostinho feliz) com seus próprios métodos.\",\"translatedTitle\":\"Desafio: Rostinho Feliz\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/object-oriented/pc/challenge-smileyface\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/object-oriented/pt/object-inheritance\",\"contentDescriptor\":\"Talkthrough:x41632a968757613b\",\"contentKind\":\"Talkthrough\",\"id\":\"x41632a968757613b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x9a11a504\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p2762128345\",\"slug\":\"object-inheritance\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pamela mostra como objetos podem herdar e reutilizar o código de outros tipos de objeto.\",\"translatedTitle\":\"Herança de Objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/object-oriented/pt/object-inheritance\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/object-oriented/a/review-object-oriented-design\",\"contentDescriptor\":\"Article:x10d55122\",\"contentKind\":\"Article\",\"id\":\"x10d55122\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x9a11a504\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"ax10d55122\",\"slug\":\"review-object-oriented-design\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Revisão: Modelo Orientado a Objetos\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/object-oriented/a/review-object-oriented-design\"}],\"id\":\"x9a11a504\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg5YTExYTUwNAw\",\"relativeUrl\":\"/computing/computer-programming/programming/object-oriented\",\"slug\":\"object-oriented\",\"translatedDescription\":\"Como usar conceitos orientados a objeto em JavaScript para criar códigos mais reutilizáveis.\",\"translatedTitle\":\"Design Orientado a Objeto\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/good-practices/a/planning-a-programming-project\",\"contentDescriptor\":\"Article:xcfdf6381\",\"contentKind\":\"Article\",\"id\":\"xcfdf6381\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8d3377f2\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"axcfdf6381\",\"slug\":\"planning-a-programming-project\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Planejamento de um projeto de programação\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/good-practices/a/planning-a-programming-project\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/good-practices/pt/planning-with-pseudo-code\",\"contentDescriptor\":\"Talkthrough:xd57e8f26fe67cfe0\",\"contentKind\":\"Talkthrough\",\"id\":\"xd57e8f26fe67cfe0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8d3377f2\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6392019672891392\",\"slug\":\"planning-with-pseudo-code\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"O que é \\\"pseudocódigo\\\", uma forma de planejar seu programa antes de codificá-lo.\",\"translatedTitle\":\"Planejamento com pseudocódigo\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/good-practices/pt/planning-with-pseudo-code\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/good-practices/a/good-practices-what-to-learn-next\",\"contentDescriptor\":\"Article:xec13d425\",\"contentKind\":\"Article\",\"id\":\"xec13d425\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8d3377f2\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"axec13d425\",\"slug\":\"good-practices-what-to-learn-next\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"O que aprender a seguir\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/good-practices/a/good-practices-what-to-learn-next\"}],\"id\":\"x8d3377f2\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg4ZDMzNzdmMgw\",\"relativeUrl\":\"/computing/computer-programming/programming/good-practices\",\"slug\":\"good-practices\",\"translatedDescription\":\"Agora que você entendeu os conceitos básicos de programação, aprenda técnicas que vão ajudá-lo a ser mais produtivo e a escrever um código melhor e mais bonito.\",\"translatedTitle\":\"Tornando-se um programador melhor\"}],\"iconPath\":\"https://cdn.kastatic.org/genfiles/topic-icons/icons/programming.png-e13016-128c.png\",\"id\":\"x05187c3c\",\"isListedForLearners\":true,\"learnableContentSummary\":{\"__typename\":\"LearnableContentSummary\",\"countExercises\":3},\"masteryEnabled\":false,\"relativeUrl\":\"/computing/computer-programming/programming\",\"slug\":\"programming\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Você já se perguntou o que é preciso para fazer desenhos animados? Bem, nós temos que falar com nosso computador numa língua especial. Nesta unidade, aprenderemos a usar a linguagem de programação JavaScript e a biblioteca JavaScript Processing para fazer nossos próprios desenhos e animações.\",\"translatedTitle\":\"Introdução a JavaScript: Desenho \\u0026 Animação\",\"unlistedAncestorIds\":null},{\"__typename\":\"Unit\",\"allOrderedChildren\":[{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/html-css/intro-to-html/v/making-webpages-intro\",\"contentDescriptor\":\"Video:x9b5f739f\",\"contentKind\":\"Video\",\"id\":\"x9b5f739f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xefc0e88a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"vx9b5f739f\",\"slug\":\"making-webpages-intro\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"A web é uma rede de computadores conectados chamados servidores que hospedam sites. Sites são programados usando linguagens como HTML, CSS e JavaScript. Os usuários acessam estes sites através de navegadores em vários dispositivos, chamados clientes. Pense em que tipo de site você  gostaria de criar!\",\"translatedTitle\":\"Bem-vindo à web!\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/intro-to-html/v/making-webpages-intro\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/intro-to-html/pt/html-basics\",\"contentDescriptor\":\"Talkthrough:xf20eef6973e94543\",\"contentKind\":\"Talkthrough\",\"id\":\"xf20eef6973e94543\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xefc0e88a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5012727132323840\",\"slug\":\"html-basics\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Fundamentos de HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/intro-to-html/pt/html-basics\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css/intro-to-html/a/quick-tip-html-tags\",\"contentDescriptor\":\"Article:x0f134878\",\"contentKind\":\"Article\",\"id\":\"x0f134878\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xefc0e88a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ax0f134878\",\"slug\":\"quick-tip-html-tags\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Dica rápida: Elementos HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/intro-to-html/a/quick-tip-html-tags\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/intro-to-html/pc/challenge-write-a-poem\",\"contentDescriptor\":\"Challenge:x047226900a9584ff\",\"contentKind\":\"Challenge\",\"id\":\"x047226900a9584ff\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xefc0e88a\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6198615379017728\",\"slug\":\"challenge-write-a-poem\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Es