ename\":\"Topic\",\"id\":\"x89af0e82\",\"masteryEnabled\":false}},\"progressKey\":\"ax4595883b\",\"slug\":\"creating-3d-shapes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Descrevendo formas 3D\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-games-visualizations/programming-3d-shapes/a/creating-3d-shapes\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-games-visualizations/programming-3d-shapes/a/drawing-3d-shapes\",\"contentDescriptor\":\"Article:x360afc57\",\"contentKind\":\"Article\",\"id\":\"x360afc57\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xfd60fa97\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x89af0e82\",\"masteryEnabled\":false}},\"progressKey\":\"ax360afc57\",\"slug\":\"drawing-3d-shapes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desenhando formas 3D\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-games-visualizations/programming-3d-shapes/a/drawing-3d-shapes\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-games-visualizations/programming-3d-shapes/a/rotating-3d-shapes\",\"contentDescriptor\":\"Article:xd24c1e01\",\"contentKind\":\"Article\",\"id\":\"xd24c1e01\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xfd60fa97\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x89af0e82\",\"masteryEnabled\":false}},\"progressKey\":\"axd24c1e01\",\"slug\":\"rotating-3d-shapes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Rotacionando formas 3D\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-games-visualizations/programming-3d-shapes/a/rotating-3d-shapes\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-games-visualizations/programming-3d-shapes/a/generating-3d-shapes\",\"contentDescriptor\":\"Article:x30b0bdb2\",\"contentKind\":\"Article\",\"id\":\"x30b0bdb2\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xfd60fa97\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x89af0e82\",\"masteryEnabled\":false}},\"progressKey\":\"ax30b0bdb2\",\"slug\":\"generating-3d-shapes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Gerando formas 3D\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-games-visualizations/programming-3d-shapes/a/generating-3d-shapes\"}],\"id\":\"xfd60fa97\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhmZDYwZmE5Nww\",\"relativeUrl\":\"/computing/computer-programming/programming-games-visualizations/programming-3d-shapes\",\"slug\":\"programming-3d-shapes\",\"translatedDescription\":\"\",\"translatedTitle\":\"Formas 3D\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-games-visualizations/advanced-development-tools/a/using-processingjs-outside-khan-academy\",\"contentDescriptor\":\"Article:x5aed3b53f813c9ba\",\"contentKind\":\"Article\",\"id\":\"x5aed3b53f813c9ba\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xcfc803ea05f9c66e\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x89af0e82\",\"masteryEnabled\":false}},\"progressKey\":\"ax5aed3b53f813c9ba\",\"slug\":\"using-processingjs-outside-khan-academy\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Usando o ProcessingJS fora Khan Academy\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-games-visualizations/advanced-development-tools/a/using-processingjs-outside-khan-academy\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-games-visualizations/advanced-development-tools/a/different-code-editors\",\"contentDescriptor\":\"Article:x7ea49b78de804619\",\"contentKind\":\"Article\",\"id\":\"x7ea49b78de804619\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xcfc803ea05f9c66e\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x89af0e82\",\"masteryEnabled\":false}},\"progressKey\":\"ax7ea49b78de804619\",\"slug\":\"different-code-editors\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Usando editores de código diferentes\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-games-visualizations/advanced-development-tools/a/different-code-editors\"}],\"id\":\"xcfc803ea05f9c66e\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIcCxIFVG9waWMiEXhjZmM4MDNlYTA1ZjljNjZlDA\",\"relativeUrl\":\"/computing/computer-programming/programming-games-visualizations/advanced-development-tools\",\"slug\":\"advanced-development-tools\",\"translatedDescription\":\"Aprenda como fazer jogos e visualizações mais complicados usando editores e ferramentas de depuração \",\"translatedTitle\":\"Ferramentas avançadas de desenvolvimento\"}],\"iconPath\":\"https://cdn.kastatic.org/genfiles/topic-icons/icons/simulations.png-955b92-128c.png\",\"id\":\"x89af0e82\",\"isListedForLearners\":true,\"learnableContentSummary\":{\"__typename\":\"LearnableContentSummary\",\"countExercises\":0},\"masteryEnabled\":false,\"relativeUrl\":\"/computing/computer-programming/programming-games-visualizations\",\"slug\":\"programming-games-visualizations\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Depois de fazer a introdução ao JS, acesse aqui para aprender técnicas que vão ajudá-lo a criar programas com várias cenas, gráficos 3D, menus com botões e jogos com pontuação.\",\"translatedTitle\":\"JavaScript Avançado: Jogos \\u0026 Visualizações\",\"unlistedAncestorIds\":null},{\"__typename\":\"Unit\",\"allOrderedChildren\":[{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/intro-natural-simulations/v/welcome-natural-simulations\",\"contentDescriptor\":\"Video:xc284b302\",\"contentKind\":\"Video\",\"id\":\"xc284b302\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xa88044a5\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"vxc284b302\",\"slug\":\"welcome-natural-simulations\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Podemos usar JavaScript e ProcessingJS para criar simulações de fenômenos naturais, como folhas caindo ou um incêndio florestal. As simulações costumam usar conceitos como aleatoriedade, ruído, vetores, forças, aceleração de ângulo e sistemas de partículas. Junte-se a nós nesta unidade enquanto consideramos como as coisas funcionam no mundo real e como podemos traduzi-las para código!\",\"translatedTitle\":\"Bem-vindo às Simulações Naturais\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/intro-natural-simulations/v/welcome-natural-simulations\"}],\"id\":\"xa88044a5\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXhhODgwNDRhNQw\",\"relativeUrl\":\"/computing/computer-programming/programming-natural-simulations/intro-natural-simulations\",\"slug\":\"intro-natural-simulations\",\"translatedDescription\":\"\",\"translatedTitle\":\"Introdução a Simulações Naturais\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/a/random-walks\",\"contentDescriptor\":\"Article:xd9727fb3\",\"contentKind\":\"Article\",\"id\":\"xd9727fb3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x06b80b68\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axd9727fb3\",\"slug\":\"random-walks\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Passeios aleatórios\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/a/random-walks\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/pc/challenge-random-blobber\",\"contentDescriptor\":\"Challenge:x9d772ba11b5654ad\",\"contentKind\":\"Challenge\",\"id\":\"x9d772ba11b5654ad\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x06b80b68\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p6192888890261504\",\"slug\":\"challenge-random-blobber\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Transforme esse walker em uma bolha aleatória mais rápida e colorida.\",\"translatedTitle\":\"Desafio: Bolha aleatória\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/pc/challenge-random-blobber\",\"userAuthoredContentType\":\"pjs\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/a/probability-non-uniform-distributions\",\"contentDescriptor\":\"Article:xe975d857\",\"contentKind\":\"Article\",\"id\":\"xe975d857\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x06b80b68\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axe975d857\",\"slug\":\"probability-non-uniform-distributions\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Probabilidade \\u0026 distribuições não uniformes\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/a/probability-non-uniform-distributions\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/a/normal-distribution-of-random-numbers\",\"contentDescriptor\":\"Article:x43d90868\",\"contentKind\":\"Article\",\"id\":\"x43d90868\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x06b80b68\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax43d90868\",\"slug\":\"normal-distribution-of-random-numbers\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Distribuição normal de números aleatórios\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/a/normal-distribution-of-random-numbers\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/a/custom-distribution-of-random-numbers\",\"contentDescriptor\":\"Article:x9f747b9d\",\"contentKind\":\"Article\",\"id\":\"x9f747b9d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x06b80b68\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"ax9f747b9d\",\"slug\":\"custom-distribution-of-random-numbers\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Distribuição personalizada de números aleatórios\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/a/custom-distribution-of-random-numbers\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/pp/project-paint-splatter\",\"contentDescriptor\":\"Project:x59955fef56f8aa27\",\"contentKind\":\"Project\",\"id\":\"x59955fef56f8aa27\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x06b80b68\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p6605630499454976\",\"slug\":\"project-paint-splatter\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eConsidere uma simulação de um desenho de mistura de cores como uma coleção de pontos coloridos. A maioria das aglomerações de tinta ficam em torno de uma posição central, mas alguns pontos espirram para as bordas. Nesse projeto, use o que você aprendeu para desenhar uma mistura de cores:\\u003c/p\\u003e\\n\\u003col class=\\\"styled-list\\\"\\u003e\\n\\u003cli\\u003eUse uma distribuição normal de números aleatórios para gerar a posição dos pontos.\\u003cli\\u003eBônus: use uma distribuição normal de números aleatórios para gerar uma paleta de cores.\\u003c/ul\\u003e\",\"translatedTitle\":\"Projeto: Mistura de cores\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness/pp/project-paint-splatter\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"x06b80b68\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgwNmI4MGI2OAw\",\"relativeUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-randomness\",\"slug\":\"programming-randomness\",\"translatedDescription\":\"\",\"translatedTitle\":\"Aleatoriedade\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-noise/a/perlin-noise\",\"contentDescriptor\":\"Article:xca32c327\",\"contentKind\":\"Article\",\"id\":\"xca32c327\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xad887cfc\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axca32c327\",\"slug\":\"perlin-noise\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Ruído de Perlin\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-noise/a/perlin-noise\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-noise/a/two-dimensional-noise\",\"contentDescriptor\":\"Article:xfe2b1a96\",\"contentKind\":\"Article\",\"id\":\"xfe2b1a96\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xad887cfc\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"axfe2b1a96\",\"slug\":\"two-dimensional-noise\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Ruído bidimensional\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-noise/a/two-dimensional-noise\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/programming-natural-simulations/programming-noise/pp/project-mountain-range\",\"contentDescriptor\":\"Project:x1835c75d023017dd\",\"contentKind\":\"Project\",\"id\":\"x1835c75d023017dd\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xad887cfc\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xc9115e5d\",\"masteryEnabled\":false}},\"progressKey\":\"p4745143008624640\",\"slug\":\"project-mountain-range\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eVocê viu que o ruído de Perlin algumas vezes é mais eficiente que a aleatoriedade para simular padrões naturais, como a forma como o programa abaixo cria uma cordilheira com apenas algumas linhas de código controladas pelo ruído. Continue usando ruído e aleatoriedade para pintar a paisagem abaixo:\\u003c/p\\u003e\\n\\u003col\\u003e\\n \\u003cli\\u003eCrie várias cordilheiras, que aparentam ir cada vez mais para o fundo do desenho, com cores diferentes.\\u003c/li\\u003e\\n \\u003cli\\u003eUse aleatoriedade para desenhar pássaros no céu.\\u003c/li\\u003e\\n \\u003cli\\u003eUse ruído para criar uma nuvem branca no céu azul.\\u003c/li\\u003e\\n \\u003cli\\u003eUse aleatoriedade para colocar pequenas árvores nas cordilheiras.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eO que mais voceê pode fazer? Use sua criatividade!\\u003c/p\\u003e\",\"translatedTitle\":\"Projeto: Cordilheira\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming-natural-simulations/programming-noise/pp/project-mountain-range\",\"userAuthoredContentType\":\"pjs\"}],\"id\":\"xad887cfc\",\"key\":\"ag5zfmtoYW4t