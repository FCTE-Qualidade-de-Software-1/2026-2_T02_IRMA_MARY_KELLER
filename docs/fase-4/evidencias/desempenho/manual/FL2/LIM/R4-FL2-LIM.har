tentType\":\"sql\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/a/who-issues-sql-queries\",\"contentDescriptor\":\"Article:x6be18ad6\",\"contentKind\":\"Article\",\"id\":\"x6be18ad6\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x65157cda\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"ax6be18ad6\",\"slug\":\"who-issues-sql-queries\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Quem realiza consultas SQL?\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/more-advanced-sql-queries/a/who-issues-sql-queries\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pt/calculating-results-with-case\",\"contentDescriptor\":\"Talkthrough:x9ccbea9d2cf73c9a\",\"contentKind\":\"Talkthrough\",\"id\":\"x9ccbea9d2cf73c9a\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x65157cda\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5859227138654208\",\"slug\":\"calculating-results-with-case\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Calculando resultados com CASE\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pt/calculating-results-with-case\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pc/challenge-gradebook\",\"contentDescriptor\":\"Challenge:xdbf1fe465c5abae6\",\"contentKind\":\"Challenge\",\"id\":\"xdbf1fe465c5abae6\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x65157cda\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5084165154406400\",\"slug\":\"challenge-gradebook\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Livro de atividades\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pc/challenge-gradebook\",\"userAuthoredContentType\":\"sql\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pp/project-data-dig\",\"contentDescriptor\":\"Project:x4ea6c20ac92a0418\",\"contentKind\":\"Project\",\"id\":\"x4ea6c20ac92a0418\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x65157cda\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5169301208301568\",\"slug\":\"project-data-dig\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"    \\u003cp\\u003eSelecionamos alguns conjuntos de dados interessantes para você:\\n    \\u003ca href=\\\"https://gist.github.com/pamelafox/b98e03caca7d1ec14394a90ec1512cff\\\"\\u003eAstronautas da NASA\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/3d8ab901def3577a8bfc881f6255d3f6\\\"\\u003eResultados do Superbowl\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/26b9357c6120d3d0d27c2b90c950e8c6\\\"\\u003eEstatísticas de Pokemon\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/6cda1115e2bcbc43e62cf4ff9d4158c7\\\"\\u003eJogadores da NBA\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/c705b02114ea3db0dff0\\\"\\u003eMelhores filmes\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/ad4f6abbaac0a48aa781\\\"\\u003eMaiores países por população\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/30acd9ca938c8a62fb92\\\"\\u003eObjetos do sistema solar por tamanho\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/585364b62390ea720858\\\"\\u003ePersonagens da Marvel\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/791ce9e4eb31abce2362\\\"\\u003eVendas de loja de móveis\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/fac85fdac119cb98266b\\\"\\u003eMedalhas da KA conquistadas\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/b90d715f2bd7984b372a\\\"\\u003eRegistro das rosquinhas Winston's\\u003c/a\\u003e, \\u003ca href=\\\"https://gist.github.com/pamelafox/1ddbcb55f9ba1f6ec435\\\"\\u003eResultados do jogo de cartas\\u003c/a\\u003e, e \\u003ca href=\\\"https://gist.github.com/pamelafox/3360f582f3309dd4c25b\\\"\\u003eEscolhas do draft da NFL\\u003c/a\\u003e.\\n    \\u003c/p\\u003e\\n\\n    \\u003cp\\u003eEscolha um desses conjuntos de dados ou crie um conjunto de dados como esses e utilize consultas \\u003ccode\\u003eSELECT\\u003c/code\\u003e avançadas para descobrir coisas sobre os dados. Que tipo de perguntas alguém pode ter sobre esses dados, como se eles os estivessem usando para um aplicativo ou uma ideia de negócio? Aqui estão algumas ideias:\\u003c/p\\u003e\\n    \\u003cul class=\\\"styled-list\\\"\\u003e\\n        \\u003cli\\u003eQuais são os valores médio, máximo e mínimo dos dados?\\u003c/li\\u003e\\n        \\u003cli\\u003eE quais são esses números por categoria nos dados (usando HAVING)?\\u003c/li\\u003e\\n        \\u003cli\\u003eQuais são as maneiras para agrupar os valores de dados que ainda não existem (usando CASE)?\\u003c/li\\u003e\\n        \\u003cli\\u003eQuais maneiras interessantes existem para filtrar os dados (usando AND/OR)?\\u003c/li\\u003e\\n    \\u003c/ul\\u003e\",\"translatedTitle\":\"Projeto: Coleta de dados\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pp/project-data-dig\",\"userAuthoredContentType\":\"sql\"}],\"id\":\"x65157cda\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg2NTE1N2NkYQw\",\"relativeUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries\",\"slug\":\"more-advanced-sql-queries\",\"translatedDescription\":\"Aprenda a realizar consultas SQL mais avançadas usando AND/OR, IN, LIKE, HAVING e outros comandos.\",\"translatedTitle\":\"Consultas SQL mais avançadas\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/sql/relational-queries-in-sql/a/splitting-data-into-related-tables\",\"contentDescriptor\":\"Article:x99315768\",\"contentKind\":\"Article\",\"id\":\"x99315768\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x09cfa153\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"ax99315768\",\"slug\":\"splitting-data-into-related-tables\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Separando dados em tabelas relacionadas\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/relational-queries-in-sql/a/splitting-data-into-related-tables\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/relational-queries-in-sql/pt/joining-related-tables\",\"contentDescriptor\":\"Talkthrough:x0fc14f4d6b0f5dc2\",\"contentKind\":\"Talkthrough\",\"id\":\"x0fc14f4d6b0f5dc2\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x09cfa153\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5527256273387520\",\"slug\":\"joining-related-tables\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Associando tabelas relacionadas com JOIN\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/relational-queries-in-sql/pt/joining-related-tables\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/relational-queries-in-sql/pc/challenge-bobbys-hobbies\",\"contentDescriptor\":\"Challenge:xddc6fbb62a95f89c\",\"contentKind\":\"Challenge\",\"id\":\"xddc6fbb62a95f89c\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x09cfa153\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5132692479934464\",\"slug\":\"challenge-bobbys-hobbies\",\"translatedCus