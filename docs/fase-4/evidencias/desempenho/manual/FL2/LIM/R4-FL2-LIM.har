\",\"endTime\":4822,\"kaIsValid\":true,\"startTime\":2910,\"text\":\"fazendo um rosto com círculos.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":8269,\"kaIsValid\":true,\"startTime\":4822,\"text\":\"Para desenhar um círculo, nós usaremos \\no comando \\\"elipse\\\",\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":11144,\"kaIsValid\":true,\"startTime\":9118,\"text\":\"então vou digitar \\\"elipse\\\" no editor.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":14294,\"kaIsValid\":true,\"startTime\":11996,\"text\":\"Após escrever o nome do comando \\nnum programa\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":18239,\"kaIsValid\":true,\"startTime\":14294,\"text\":\"eu sempre coloco um parênteses \\ne um ponto e vírgula.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":21610,\"kaIsValid\":true,\"startTime\":19470,\"text\":\"Mas eu não vejo uma elipse.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":25207,\"kaIsValid\":true,\"startTime\":22940,\"text\":\"O lado direito ainda é aquele \\nquadro branco chato.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":28857,\"kaIsValid\":true,\"startTime\":26431,\"text\":\"Bom, não há uma elipse ainda porque \\neu preciso passar\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":32327,\"kaIsValid\":true,\"startTime\":28857,\"text\":\"mais informação sobre onde \\ndesenhar a elipse\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":34409,\"kaIsValid\":true,\"startTime\":32327,\"text\":\"e qual o tamanho que ela deve ter.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":38950,\"kaIsValid\":true,\"startTime\":35914,\"text\":\"Como estou desenhando um rosto, \\neu quero que essa elipse\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":41732,\"kaIsValid\":true,\"startTime\":38950,\"text\":\"seja bem no centro do quadro\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":42975,\"kaIsValid\":true,\"startTime\":41732,\"text\":\"e bem grande.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":46336,\"kaIsValid\":true,\"startTime\":44363,\"text\":\"Vou digitar 4 números.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":48346,\"kaIsValid\":true,\"startTime\":46929,\"text\":\"Isso fará o que queremos.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":50668,\"kaIsValid\":true,\"startTime\":48683,\"text\":\"E nós vamos explorar o por que eles funcionam.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":54614,\"kaIsValid\":true,\"startTime\":52925,\"text\":\"Ta-da, um rosto.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":57464,\"kaIsValid\":true,\"startTime\":54952,\"text\":\"Ok, então esse é o primeiro número,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":58769,\"kaIsValid\":true,\"startTime\":57465,\"text\":\"o que ele controla?\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":62452,\"kaIsValid\":true,\"startTime\":59625,\"text\":\"Eu posso mudá-lo clicando nele e \\nusando os números\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":64111,\"kaIsValid\":true,\"startTime\":62452,\"text\":\"para cobrir o trajeto do conjunto.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":66904,\"kaIsValid\":true,\"startTime\":64111,\"text\":\"Veja, ele está se movendo ao longo da tela.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":70930,\"kaIsValid\":true,\"startTime\":67494,\"text\":\"Então esse número controla o quão \\nlonge a elipse está\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":72971,\"kaIsValid\":true,\"startTime\":70930,\"text\":\"do lado esquerdo do quadro.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":76690,\"kaIsValid\":true,\"startTime\":74498,\"text\":\"E o segundo número?\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":79893,\"kaIsValid\":true,\"startTime\":76690,\"text\":\"Se eu mudá-lo, a elipse move para cima\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":81411,\"kaIsValid\":true,\"startTime\":79893,\"text\":\"e para baixo no quadro.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":82782,\"kaIsValid\":true,\"startTime\":81861,\"text\":\"Ok.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":85344,\"kaIsValid\":true,\"startTime\":83592,\"text\":\"Agora para o terceiro número.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":88866,\"kaIsValid\":true,\"startTime\":85792,\"text\":\"Mudando ele nós fazemos a elipse mais larga\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":90381,\"kaIsValid\":true,\"startTime\":88866,\"text\":\"ou fina.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":92536,\"kaIsValid\":true,\"startTime\":90958,\"text\":\"Muito bem.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":94668,\"kaIsValid\":true,\"startTime\":93300,\"text\":\"Finalmente, o quarto número.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":97598,\"kaIsValid\":true,\"startTime\":95261,\"text\":\"O que mais podemos mudar?\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":102172,\"kaIsValid\":true,\"startTime\":97598,\"text\":\"A altura, fazendo a elipse mais alta ou curta,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":103881,\"kaIsValid\":true,\"startTime\":102697,\"text\":\"meio achatada.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":106437,\"kaIsValid\":true,\"startTime\":104594,\"text\":\"Vamos torná-la alta novamente.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":107732,\"kaIsValid\":true,\"startTime\":106927,\"text\":\"Ok.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":110150,\"kaIsValid\":true,\"startTime\":107732,\"text\":\"Agora você sabe o que todos os números fazem.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":113500,\"kaIsValid\":true,\"startTime\":110150,\"text\":\"Os dois primeiros controlam a posição da elipse\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":115847,\"kaIsValid\":true,\"startTime\":113500,\"text\":\"e o dois últimos controlam o tamanho da elipse.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":120844,\"kaIsValid\":true,\"startTime\":116730,\"text\":\"Nós chamamos esses números de parâmetros para o comando \\\"elipse\\\".\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":125504,\"kaIsValid\":true,\"startTime\":121697,\"text\":\"E na verdade, nós normalmente chamamos esse comando de \\\"função\\\".\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":130621,\"kaIsValid\":true,\"startTime\":126424,\"text\":\"Então aqui no nosso programa nós estamos \\nchamando a \\\"função elipse\\\"\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":134429,\"kaIsValid\":true,\"startTime\":130621,\"text\":\"e  passando a ela quatro parâmetros que \\nmudam como ela desenha\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":135616,\"kaIsValid\":true,\"startTime\":134429,\"text\":\"uma elipse.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":139587,\"kaIsValid\":true,\"startTime\":136585,\"text\":\"Quando nós descrevemos os parâmetros \\nde uma função,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":142259,\"kaIsValid\":true,\"startTime\":139587,\"text\":\"nós normalmente damos a eles apelidos, para que não precisemos sempre falar\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":143738,\"kaIsValid\":true,\"startTime\":142259,\"text\":\"primeiro e segundo.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":147450,\"kaIsValid\":true,\"startTime\":144592,\"text\":\"Vamos ver os apelidos para esses parâmetros.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":151594,\"kaIsValid\":true,\"startTime\":148427,\"text\":\"O primeiro parâmetro, lembre-se\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":152936,\"kaIsValid\":true,\"startTime\":151594,\"text\":\"que ele controla isso.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":157157,\"kaIsValid\":true,\"startTime\":153678,\"text\":\"Nós chamamos esse parâmetro de X, por que pensamos\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":161829,\"kaIsValid\":true,\"startTime\":157157,\"text\":\"no x como a direção que atravessa o quadro,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":163745,\"kaIsValid\":true,\"startTime\":162359,\"text\":\"como estou mostrando aqui.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":165946,\"kaIsValid\":true,\"startTime\":164592,\"text\":\"Ele começa no zero\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":169334,\"kaIsValid\":true,\"startTime\":166930,\"text\":\"e termina no 400.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":173143,\"kaIsValid\":true,\"startTime\":170815,\"text\":\"Então esse é o nosso x.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":178136,\"kaIsValid\":true,\"startTime\":174931,\"text\":\"O segundo parâmetro nós chamamos de Y,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":180444,\"kaIsValid\":true,\"startTime\":178931,\"text\":\"por que ele controla\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":182891,\"kaIsValid\":true,\"startTime\":181562,\"text\":\"essa direção.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":184796,\"kaIsValid\":true,\"startTime\":182891,\"text\":\"E nós pensamos no y como a direção\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":186971,\"kaIsValid\":true,\"startTime\":184796,\"text\":\"que desce no quadro.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":189300,\"kaIsValid\":true,\"startTime\":187391,\"text\":\"Esse é o y.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":192392,\"kaIsValid\":true,\"startTime\":189300,\"text\":\"E ele também começa no zero\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":196648,\"kaIsValid\":true,\"startTime\":192393,\"text\":\"e vai até o 400 no final da parte inferior.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":199801,\"kaIsValid\":true,\"startTime\":197666,\"text\":\"Então esse é o x e y.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":203940,\"kaIsValid\":true,\"startTime\":200789,\"text\":\"Nós chamamos o terceiro parâmetro de Largura\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":205300,\"kaIsValid\":true,\"startTime\":203940,\"text\":\"por que ele controla a largura,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":207580,\"kaIsValid\":true,\"startTime\":205300,\"text\":\"e o quarto parâmetro de Altura.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":209347,\"kaIsValid\":true,\"startTime\":208454,\"text\":\"Ok.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":213292,\"kaIsValid\":true,\"startTime\":209861,\"text\":\"Então agora nós entendemos o que o código está fazendo\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":215190,\"kaIsValid\":true,\"startTime\":213292,\"text\":\"e o por que ele dele,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":216407,\"kaIsValid\":true,\"startTime\":215190,\"text\":\"então vamos escrever mais código.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":219496,\"kaIsValid\":true,\"startTime\":217693,\"text\":\"Nós temos nosso rosto\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":222697,\"kaIsValid\":true,\"startTime\":219496,\"text\":\"mas ele precisa de uma boca\\npara poder comer coisas.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":225874,\"kaIsValid\":true,\"startTime\":222697,\"text\":\"Eu irei fazer uma boca digitando \\numa segunda elipse abaixo.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":231126,\"kaIsValid\":true,\"startTime\":226921,\"text\":\"Eu utilizarei o mesmo x da elipse anterior\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":234355,\"kaIsValid\":true,\"startTime\":231126,\"text\":\"por que quero ele no centro do rosto\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":237221,\"kaIsValid\":true,\"startTime\":234355,\"text\":\"mas eu também quero ele \\num pouco mais abaixo.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":240280,\"kaIsValid\":true,\"startTime\":237222,\"text\":\"Então vou tentar 250 para o y.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":244912,\"kaIsValid\":true,\"startTime\":242320,\"text\":\"Para o tamanho, eu quero que \\nseja menor que o rosto.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":248436,\"kaIsValid\":true,\"startTime\":245596,\"text\":\"Vou tentar 110.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":252987,\"kaIsValid\":true,\"startTime\":250310,\"text\":\"Ok, é um pouco pequeno.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":256697,\"kaIsValid\":true,\"startTime\":252987,\"text\":\"Vou só alargar ele um pouco.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":257745,\"kaIsValid\":true,\"startTime\":256697,\"text\":\"Muito bem.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":262489,\"kaIsValid\":true,\"startTime\":258793,\"text\":\"Agora precisamos de olhos, por que \\num rosto sem olhos\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":263847,\"kaIsValid\":true,\"startTime\":262489,\"text\":\"é um pouco assustador.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":266114,\"kaIsValid\":true,\"startTime\":264595,\"text\":\"Vamos começar com o olho esquerdo.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":270263,\"kaIsValid\":true,\"startTime\":267286,\"text\":\"Ele deve ficar mais próximo do lado esquerdo\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":273772,\"kaIsValid\":true,\"startTime\":270263,\"text\":\"do que no centro, então vou tentar 150\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":277727,\"kaIsValid\":true,\"startTime\":274864,\"text\":\"e ele deve estar mais próximo do topo,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":280300,\"kaIsValid\":true,\"startTime\":277727,\"text\":\"então vou tentar 150 para o y também.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":284287,\"kaIsValid\":true,\"startTime\":281121,\"text\":\"E eles devem pequenos círculos perfeitos,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":286144,\"kaIsValid\":true,\"startTime\":284288,\"text\":\"então vou tentar 30, 30.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":290155,\"kaIsValid\":true,\"startTime\":287363,\"text\":\"Ok, eu não vejo meus olhos ainda,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":290993,\"kaIsValid\":true,\"startTime\":290155,\"text\":\"o que aconteceu de errado?\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":293228,\"kaIsValid\":true,\"startTime\":290993,\"text\":\"Ah, aqui está o erro.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":296510,\"kaIsValid\":true,\"startTime\":293228,\"text\":\"Ah não gente, nosso amigo \\\"Oh noes\\\", aparece aqui\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":297990,\"kaIsValid\":true,\"startTime\":296510,\"text\":\"e está me dizendo que alguma \\ncoisa está errada\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":299940,\"kaIsValid\":true,\"startTime\":297990,\"text\":\"com o código.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":301763,\"kaIsValid\":true,\"startTime\":299940,\"text\":\"Está faltando um ponto e vírgula.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":303429,\"kaIsValid\":true,\"startTime\":301763,\"text\":\"Onde está faltando?\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":306725,\"kaIsValid\":true,\"startTime\":303430,\"text\":\"Linha 5, a linha de código \\nque acabei de escrever,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":308126,\"kaIsValid\":true,\"startTime\":306725,\"text\":\"esqueci de colocar o ponto e vírgula.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":311429,\"kaIsValid\":true,\"startTime\":308126,\"text\":\"Erro normal, eu vou colocar ele aqui\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":313411,\"kaIsValid\":true,\"startTime\":311430,\"text\":\"e pronto, nós temos o nosso olho.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":316657,\"kaIsValid\":true,\"startTime\":314227,\"text\":\"Agora, você provavelmente \\nverá \\\"Oh noes\\\" muitos vezes\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":319359,\"kaIsValid\":true,\"startTime\":316657,\"text\":\"quando estiver começando, por que \\né a sua primeira vez\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":321890,\"kaIsValid\":true,\"startTime\":319359,\"text\":\"escrevendo código e leva algum \\ntempo para se acostumar\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":325463,\"kaIsValid\":true,\"startTime\":321891,\"text\":\"com a sintaxe, garantir que tudo \\nestá digitado corretamente\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":328692,\"kaIsValid\":true,\"startTime\":325463,\"text\":\"e usar os parênteses corretos, e sempre\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":330790,\"kaIsValid\":true,\"startTime\":328692,\"text\":\"colocar o ponto e vírgula no final.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":333662,\"kaIsValid\":true,\"startTime\":330890,\"text\":\"Então não se preocupe se você encontrar o \\n\\\"Oh noes\\\" muitas vezes,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":334529,\"kaIsValid\":true,\"startTime\":333662,\"text\":\"você se acostumará com ele.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":335874,\"kaIsValid\":true,\"startTime\":334529,\"text\":\"(risadas)\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":338419,\"kaIsValid\":true,\"startTime\":336263,\"text\":\"Muito bem, agora finalmente,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":341996,\"kaIsValid\":true,\"startTime\":338419,\"text\":\"não estamos desenhando um ciclopes, então precisamos de mais um olho.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":344164,\"kaIsValid\":true,\"startTime\":341996,\"text\":\"Já que o nosso outro olho é bem parecido\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":347150,\"kaIsValid\":true,\"startTime\":344164,\"text\":\"com o olho esquerdo, eu só vou copiar\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":349472,\"kaIsValid\":true,\"startTime\":347150,\"text\":\"essa linha de código e colar,\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":353300,\"kaIsValid\":true,\"startTime\":350250,\"text\":\"e então mover o x\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":354895,\"kaIsValid\":true,\"startTime\":353300,\"text\":\"e pronto.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":356222,\"kaIsValid\":true,\"startTime\":354896,\"text\":\"Lindo!\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":358100,\"kaIsValid\":true,\"startTime\":356222,\"text\":\"Meu rosto está pronto.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":361592,\"kaIsValid\":true,\"startTime\":358627,\"text\":\"E eu posso estar com um pouco de fome também.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":362931,\"kaIsValid\":true,\"startTime\":361592,\"text\":\"Mmm.\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":366220,\"kaIsValid\":true,\"startTime\":362932,\"text\":\"Bom, agora você irá tentar desenhar alguns círculos\"},{\"__typename\":\"VideoSubtitle\",\"endTime\":367879,\"kaIsValid\":true,\"startTime\":366220,\"text\":\"escrevendo seu próprio código.\"}],\"translatedDescription\":\"Vamos explicar como desenhar círculos com códigos (JavaScript e ProcessingJS), e, em seguida, você tentará fazê-los em um desafio.\",\"translatedMp3Url\":\"https://cdn.kastatic.org/ka-cs-scratchpad-audio/pt/D5HQw_GKOwo-20171205-193112.mp3\",\"translatedTitle\":\"Desenhando com código\",\"userAuthoredContentType\":\"pjs\",\"width\":400,\"youtubeId\":\"D5HQw_GKOwo\"},\"lesson\":{\"__typename\":\"Lesson\",\"contentId\":\"xf53d7aa7\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/programming/drawing-basics/pt/making-drawings-with-code\",\"contentDescriptor\":\"Talkthrough:xe7fd4c285496ab91\",\"contentKind\":\"Talkthrough\",\"id\":\"xe7fd4c285496ab91\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xf53d7aa7\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x05187c3c\",\"masteryEnabled\":false}},\"progressKey\":\"p6494798146568192\",\"slug\":\"making-drawings-with-code\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Vamos explicar como desenhar círculos com códigos (JavaScript e ProcessingJS), e, em seguida, você tentará fazê-los em um desafio.\",\"translatedTitle\":\"Desenhando com código\",\"urlWithinCurationNode\":\"/computing/computer-programming/programming/drawing-basics/pt/making-drawings-with-code\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/programming/drawing-basics/a/quick-tip-number-scrubbing\",\"contentDescriptor\":\"Article:x84855443\",\"contentKind\":\"Article\",\"id\":\"x84855443\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"xf53d7aa7\",\"parent\":{\"__typename\"