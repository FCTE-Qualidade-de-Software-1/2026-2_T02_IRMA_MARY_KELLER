ramming/html-css/css-layout-properties/pc/challenge-the-boxer-model\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pt/css-position\",\"contentDescriptor\":\"Talkthrough:x81af87de20723afb\",\"contentKind\":\"Talkthrough\",\"id\":\"x81af87de20723afb\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4615703178248192\",\"slug\":\"css-position\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Posição CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pt/css-position\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pc/challenge-position-planet\",\"contentDescriptor\":\"Challenge:xf6f727fed1df6342\",\"contentKind\":\"Challenge\",\"id\":\"xf6f727fed1df6342\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5153121644052480\",\"slug\":\"challenge-position-planet\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Posicionamento do planeta\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pc/challenge-position-planet\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/v/css-in-the-wild-google-maps\",\"contentDescriptor\":\"Video:x3f1a907e\",\"contentKind\":\"Video\",\"id\":\"x3f1a907e\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"vx3f1a907e\",\"slug\":\"css-in-the-wild-google-maps\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Vamos explorar as propriedades de posicionamento do CSS e z-index no Google Maps usando as ferramentas de desenvolvimento do nosso navegador para inspecionar o código CSS. Essas propriedades são usadas para camadas e elementos de posicionamento na página, como o mini mapa, informações que aparecem quando você passa o mouse, e o botão de zoom. Veja como os conceitos de CSS que estamos aprendendo são aplicados em sites complexos e interativos que usamos todos os dias!\",\"translatedTitle\":\"CSS: Google Maps\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/v/css-in-the-wild-google-maps\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pt/css-floating-elements\",\"contentDescriptor\":\"Talkthrough:x1007f5d23dee9ad3\",\"contentKind\":\"Talkthrough\",\"id\":\"x1007f5d23dee9ad3\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4635563442569216\",\"slug\":\"css-floating-elements\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Elementos CSS flutuantes\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pt/css-floating-elements\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pc/challenge-floating-clouds\",\"contentDescriptor\":\"Challenge:xc6ccc133c7b23ff9\",\"contentKind\":\"Challenge\",\"id\":\"xc6ccc133c7b23ff9\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5435078412075008\",\"slug\":\"challenge-floating-clouds\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Nuvens flutuantes\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pc/challenge-floating-clouds\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/e/quiz--css-layout\",\"contentDescriptor\":\"Exercise:x46958c79\",\"contentKind\":\"Exercise\",\"exerciseLength\":5,\"id\":\"x46958c79\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ex46958c79\",\"slug\":\"quiz--css-layout\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":5,\"upperBound\":8},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Pratique propriedades e conceitos de layout em CSS.\",\"translatedTitle\":\"Usando propriedades de leiaute CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/e/quiz--css-layout\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/a/planning-your-webpage\",\"contentDescriptor\":\"Article:xcbf6fe3e\",\"contentKind\":\"Article\",\"id\":\"xcbf6fe3e\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"axcbf6fe3e\",\"slug\":\"planning-your-webpage\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Planejando sua página web\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/a/planning-your-webpage\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/html-css/css-layout-properties/pp/project-event-invite\",\"contentDescriptor\":\"Project:x71333e3f134714a9\",\"contentKind\":\"Project\",\"id\":\"x71333e3f134714a9\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x6787034c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6750832828350464\",\"slug\":\"project-event-invite\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\\u003cp\\u003eNesse projeto, você vai fazer um convite para um evento - uma festa, um workshop, um casamento, ou o que você quiser. Ele deve ter o título do evento, os detalhes e talvez uma lista de convidados ou um botão de confirmação.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eAntes de começar a programar, é importante que você faça o \\\"protótipo\\\" - fazer o planejamento em papel ou com uma ferramenta apropriada. Esboce a visão que você tem na cabeça e faça alguns protótipos até ficar satisfeito.\\u003c/p\\u003e\\n\\n\\u003cp\\u003eQuando você estiver pronto, tente implementar seu convite para o evento em HTML/CSS. Se você tiver problemas com alguma coisa que é difícil de transferir do papel para o HTML, tente pesquisar na internet ou clique em \\\"Pedir ajuda\\\". Eu aposto que você vai aprender alguma coisa no processo.\\u003c/p\\u003e\\n \",\"translatedTitle\":\"Projeto: convite de evento\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/css-layout-properties/pp/project-event-invite\",\"userAuthoredContentType\":\"webpage\"}],\"id\":\"x6787034c\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg2Nzg3MDM0Yww\",\"relativeUrl\":\"/computing/computer-programming/html-css/css-layout-properties\",\"slug\":\"css-layout-properties\",\"translatedDescription\":\"Aprenda a usar os elementos HTML span e div com propriedades CSS, como posicionamento e flutuação, para alterar o layout de suas páginas web.\",\"translatedTitle\":\"Layout CSS\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/using-multiple-css-classes\",\"contentDescriptor\":\"Talkthrough:xd86b6f05048cdbbc\",\"contentKind\":\"Talkthrough\",\"id\":\"xd86b6f05048cdbbc\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4939299519987712\",\"slug\":\"using-multiple-css-classes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Uso de várias classes CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pt/using-multiple-css-classes\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/combining-css-class-and-element-selectors\",\"contentDescriptor\":\"Talkthrough:x488457332bf1f0ed\",\"contentKind\":\"Talkthrough\",\"id\":\"x488457332bf1f0ed\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5418858455498752\",\"slug\":\"combining-css-class-and-element-selectors\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Combinação de classes CSS e seletores de elementos\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pt/combining-css-class-and-element-selectors\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/css-descendant-selectors\",\"contentDescriptor\":\"Talkthrough:xe319712ad3615f58\",\"contentKind\":\"Talkthrough\",\"id\":\"xe319712ad3615f58\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6374633634004992\",\"slug\":\"css-descendant-selectors\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Seletores CSS descendentes\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pt/css-descendant-selectors\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pc/challenge-descendants-of-khan\",\"contentDescriptor\":\"Challenge:x34ed3abead316408\",\"contentKind\":\"Challenge\",\"id\":\"x34ed3abead316408\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4757342446157824\",\"slug\":\"challenge-descendants-of-khan\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Descendentes de Khan\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pc/challenge-descendants-of-khan\",\"userAuthoredContentType\":\"webpage\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/grouping-css-selectors\",\"contentDescriptor\":\"Talkthrough:xf9790bad0235c849\",\"contentKind\":\"Talkthrough\",\"id\":\"xf9790bad0235c849\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p6211781778472960\",\"slug\":\"grouping-css-selectors\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Agrupamento de seletores CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pt/grouping-css-selectors\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/css-dynamic-pseudo-classes\",\"contentDescriptor\":\"Talkthrough:x7dd1a2bf15b03e96\",\"contentKind\":\"Talkthrough\",\"id\":\"x7dd1a2bf15b03e96\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p5180385597325312\",\"slug\":\"css-dynamic-pseudo-classes\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Pseudoclasses CSS dinâmicas\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pt/css-dynamic-pseudo-classes\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/pt/css-specificity\",\"contentDescriptor\":\"Talkthrough:x9fef48b9b65cd79c\",\"contentKind\":\"Talkthrough\",\"id\":\"x9fef48b9b65cd79c\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"p4750409140011008\",\"slug\":\"css-specificity\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Especificidade CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/pt/css-specificity\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/html-css/more-css-selectors/e/quiz--css-specificity-rules\",\"contentDescriptor\":\"Exercise:x31250993\",\"contentKind\":\"Exercise\",\"exerciseLength\":4,\"id\":\"x31250993\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x2e46f213\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ex31250993\",\"slug\":\"quiz--css-specificity-rules\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":4,\"upperBound\":6},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Teste seu conhecimento sobre as regras de especificidade CSS.\",\"translatedTitle\":\"Regras de especificidade CSS\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/more-css-selectors/e/quiz--css-specificity-rules\"}],\"id\":\"x2e46f213\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgyZTQ2ZjIxMww\",\"relativeUrl\":\"/computing/computer-programming/html-css/more-css-selectors\",\"slug\":\"more-css-selectors\",\"translatedDescription\":\"Aprenda seletores mais complexos - usando várias classes, combinando elementos com classes, seletores descendentes, seletores agrupados e pseudoclasses dinâmicas.\",\"translatedTitle\":\"Mais seletores CSS\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-css-further-learning/a/webpage-design\",\"contentDescriptor\":\"Article:x9ccc09f7\",\"contentKind\":\"Article\",\"id\":\"x9ccc09f7\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3c59ea3c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ax9ccc09f7\",\"slug\":\"webpage-design\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Design de página web\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-css-further-learning/a/webpage-design\"},{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-css-further-learning/v/html-validation\",\"contentDescriptor\":\"Video:x375b2a8b\",\"contentKind\":\"Video\",\"id\":\"x375b2a8b\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3c59ea3c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"vx375b2a8b\",\"slug\":\"html-validation\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Navegadores podem se adaptar e mostrar páginas web mesmo quando há erros no código. No entanto, para garantir que sua página funcione de forma consistente em navegadores diferentes, é uma boa ideia validar seu HTML usando o serviço de validação do W3. Vamos mostrar como usar o serviço do validador W3C para arrumar erros comuns, como esquecer de incluir atributos em imagens.\",\"translatedTitle\":\"Validação HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-css-further-learning/v/html-validation\"},{\"__typename\":\"Exercise\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-css-further-learning/e/quiz--validate-this-html\",\"contentDescriptor\":\"Exercise:x488fb047\",\"contentKind\":\"Exercise\",\"exerciseLength\":4,\"id\":\"x488fb047\",\"isSkillCheck\":false,\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3c59ea3c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"ex488fb047\",\"slug\":\"quiz--validate-this-html\",\"sponsored\":false,\"thumbnailUrl\":\"https://lh3.googleusercontent.com/BeOgMWy4wbB_Q_hya2R5VB6kM67lVZt4Kk7QK0qeQF8kNTAZdgQySmtM2CjlKCnM43zq5iJ325T-aH9yhE89dd4\",\"timeEstimate\":{\"__typename\":\"TimeEstimate\",\"lowerBound\":4,\"upperBound\":6},\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Tente validar pequenas páginas HTML e descubra o que está errado.\",\"translatedTitle\":\"Validando HTML\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-css-further-learning/e/quiz--validate-this-html\"},{\"__typename\":\"Article\",\"canonicalUrl\":\"/computing/computer-programming/html-css/html-css-further-learning/a/html-css-further-learning-what-to-learn-next\",\"contentDescriptor\":\"Article:xd2d98915\",\"contentKind\":\"Article\",\"id\":\"xd2d98915\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x3c59ea3c\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"x7441c73b\",\"masteryEnabled\":false}},\"progressKey\":\"axd2d98915\",\"slug\":\"html-css-further-learning-what-to-learn-next\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"O que aprender a seguir\",\"urlWithinCurationNode\":\"/computing/computer-programming/html-css/html-css-further-learning/a/html-css-further-learning-what-to-learn-next\"}],\"id\":\"x3c59ea3c\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXgzYzU5ZWEzYww\",\"relativeUrl\":\"/computing/computer-programming/html-css/html-css-further-learning\",\"slug\":\"html-css-further-learning\",\"translatedDescription\":\"O que você pode fazer para continuar aprendendo HTML e CSS?\",\"translatedTitle\":\"Aprendizagem futura\"}],\"iconPath\":\"https://cdn.kastatic.org/genfiles/topic-icons/icons/markup.png-8a1e75-128c.png\",\"id\":\"x7441c73b\",\"isListedForLearners\":true,\"learnableContentSummary\":{\"__typename\":\"LearnableContentSummary\",\"countExercises\":5},\"masteryEnabled\":false,\"relativeUrl\":\"/computing/computer-programming/html-css\",\"slug\":\"html-css\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Aprenda a usar HTML e CSS para criar páginas web. HTML é a linguagem de marcação com a qual você envolve o conteúdo, para instruir os navegadores sobre cabeçalhos, listas, tabelas, etc. CSS é a linguagem de estilos que você usa para estilizar a página, para instruir os navegadores a alterar a cor, a fonte, o layout e muito mais.\",\"translatedTitle\":\"Introdução a HTML/CSS: criação de páginas Web\",\"unlistedAncestorIds\":null},{\"__typename\":\"Unit\",\"allOrderedChildren\":[{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/v/welcome-to-sql\",\"contentDescriptor\":\"Video:xe44b888f\",\"contentKind\":\"Video\",\"id\":\"xe44b888f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"vxe44b888f\",\"slug\":\"welcome-to-sql\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"SQL ou linguagem de consulta estruturada (Structured Querry Language em inglês), é uma linguagem especificamente concebida para acessar e interagir com bancos de dados. Ela permite aos usuários criar tabelas, modificar dados e recuperar informações de forma rápida e eficiente. O SQL é uma das linguagens de consulta mais populares em uso hoje.\",\"translatedTitle\":\"Bem-vindo ao SQL\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/v/welcome-to-sql\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pt/creating-a-table-and-inserting-data\",\"contentDescriptor\":\"Talkthrough:x245bbc2f163a845d\",\"contentKind\":\"Talkthrough\",\"id\":\"x245bbc2f163a845d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6503853165117440\",\"slug\":\"creating-a-table-and-inserting-data\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Criando uma tabela e inserindo dados\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pt/creating-a-table-and-inserting-data\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-book-list-database\",\"contentDescriptor\":\"Challenge:x4730b42e816fe5e0\",\"contentKind\":\"Challenge\",\"id\":\"x4730b42e816fe5e0\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p4845950473601024\",\"slug\":\"challenge-book-list-database\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Armazene seus livros favoritos em uma tabela\",\"translatedTitle\":\"Desafio: Banco de dados com lista de livros\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-book-list-database\",\"userAuthoredContentType\":\"sql\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pt/querying-the-table\",\"contentDescriptor\":\"Talkthrough:x164d4f53db1bd546\",\"contentKind\":\"Talkthrough\",\"id\":\"x164d4f53db1bd546\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6003599625945088\",\"slug\":\"querying-the-table\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Consultar a tabela\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pt/querying-the-table\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-box-office-hits-database\",\"contentDescriptor\":\"Challenge:xd89c8bb8523d3c0d\",\"contentKind\":\"Challenge\",\"id\":\"xd89c8bb8523d3c0d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6304653454344192\",\"slug\":\"challenge-box-office-hits-database\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Consulte um banco de dados de filmes de maneiras diferentes.\",\"translatedTitle\":\"Desafio: Banco de dados de sucessos de bilheteria\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-box-office-hits-database\",\"userAuthoredContentType\":\"sql\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pt/aggregating-data\",\"contentDescriptor\":\"Talkthrough:x7a36dc5b66098882\",\"contentKind\":\"Talkthrough\",\"id\":\"x7a36dc5b66098882\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6288707168763904\",\"slug\":\"aggregating-data\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Agregando dados\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pt/aggregating-data\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-todo-list-database-stats\",\"contentDescriptor\":\"Challenge:xc23c12790f4cf614\",\"contentKind\":\"Challenge\",\"id\":\"xc23c12790f4cf614\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5826099759284224\",\"slug\":\"challenge-todo-list-database-stats\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Estatísticas de consulta de uma lista de afazeres.\",\"translatedTitle\":\"Desafio: Estatísticas do banco de dados de lista de afazeres\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pc/challenge-todo-list-database-stats\",\"userAuthoredContentType\":\"sql\"},{\"__typename\":\"Video\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/v/s-q-l-or-sequel\",\"contentDescriptor\":\"Video:xab93c62d\",\"contentKind\":\"Video\",\"id\":\"xab93c62d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"vxab93c62d\",\"slug\":\"s-q-l-or-sequel\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Como pronunciar SQL? Quando a IBM inventou o SQL, que significa Structured Querry Language (linguagem de consulta estruturada), eles originalmente a chamaral de SEQUEL. No entanto, depois eles acabaram mudando o nome para SQL por questões de registro de marca. Muitas pessoas ainda pronunciam SQL como \\\"sequel\\\" por razões históricas, enquanto outros pronunciam como \\\"S-Q-L\\\". As duas pronúncias são corretas e comumente usadas!\",\"translatedTitle\":\"S Q L ou SEQUEL?\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/v/s-q-l-or-sequel\"},{\"__typename\":\"Project\",\"canonicalUrl\":\"/computing/computer-programming/sql/sql-basics/pp/project-design-a-store-database\",\"contentDescriptor\":\"Project:xfef09f28eed4ae90\",\"contentKind\":\"Project\",\"id\":\"xfef09f28eed4ae90\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x8c9afe49\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5327101046816768\",\"slug\":\"project-design-a-store-database\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"Crie sua própria loja! Ela deve vender um tipo de produto como roupas, bicicletas ou qualquer coisa que seja de seu interesse. Você deve ter uma tabela para todos os itens na sua loja e pelo menos 5 colunas para o tipo de dado que você considera armazenar. Você deve vender pelo menos 15 itens e usar as instruções select para ordenar seus itens por preço e mostrar pelo menos uma estatística sobre os itens.\\n\",\"translatedTitle\":\"Projeto: Projetar o banco de dados de uma loja\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/sql-basics/pp/project-design-a-store-database\",\"userAuthoredContentType\":\"sql\"}],\"id\":\"x8c9afe49\",\"key\":\"ag5zfmtoYW4tYWNhZGVteXIUCxIFVG9waWMiCXg4YzlhZmU0OQw\",\"relativeUrl\":\"/computing/computer-programming/sql/sql-basics\",\"slug\":\"sql-basics\",\"translatedDescription\":\"Vamos lhe mostrar os conceitos básicos da criação de tabelas e da seleção de dados de várias formas diferentes.\",\"translatedTitle\":\"Noções básicas de SQL\"},{\"__typename\":\"Lesson\",\"curatedChildren\":[{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pt/more-complex-queries-with-andor\",\"contentDescriptor\":\"Talkthrough:x4d8b0a9d3f1b5c4a\",\"contentKind\":\"Talkthrough\",\"id\":\"x4d8b0a9d3f1b5c4a\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x65157cda\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6658097900814336\",\"slug\":\"more-complex-queries-with-andor\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Consultas mais complexas com AND/OR\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pt/more-complex-queries-with-andor\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pc/challenge-karaoke-song-selector\",\"contentDescriptor\":\"Challenge:x43f370f52384c31f\",\"contentKind\":\"Challenge\",\"id\":\"x43f370f52384c31f\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x65157cda\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p5771937686749184\",\"slug\":\"challenge-karaoke-song-selector\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Desafio: Seletor de músicas de karaokê\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pc/challenge-karaoke-song-selector\",\"userAuthoredContentType\":\"sql\"},{\"__typename\":\"Talkthrough\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pt/querying-in-subqueries\",\"contentDescriptor\":\"Talkthrough:x4fa00acec7e0ab28\",\"contentKind\":\"Talkthrough\",\"id\":\"x4fa00acec7e0ab28\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\":\"x65157cda\",\"parent\":{\"__typename\":\"Topic\",\"id\":\"xcffdaa1f\",\"masteryEnabled\":false}},\"progressKey\":\"p6453543775109120\",\"slug\":\"querying-in-subqueries\",\"translatedCustomTitleTag\":\"\",\"translatedDescription\":\"\",\"translatedTitle\":\"Realizando consultas em sub-consultas com IN\",\"urlWithinCurationNode\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pt/querying-in-subqueries\"},{\"__typename\":\"Challenge\",\"canonicalUrl\":\"/computing/computer-programming/sql/more-advanced-sql-queries/pc/challenge-playlist-maker\",\"contentDescriptor\":\"Challenge:x3d6805a5759d0b4d\",\"contentKind\":\"Challenge\",\"id\":\"x3d6805a5759d0b4d\",\"parentTopic\":{\"__typename\":\"Topic\",\"id\"