18n._(\"Bloco vazio.\"),\n\tW036: i18n._(\"/*membro '{a}' inesperado.\"),\n\tW037: i18n._(\"'{a}' \\u00e9 um r\\u00f3tulo de instru\\u00e7\\u00e3o.\"),\n\tW038: i18n._(\"'{a}' usado fora do escopo.\"),\n\tW039: i18n._(\"'{a}' n\\u00e3o \\u00e9 permitido.\"),\n\tW040: i18n._(\"Poss\\u00edvel viola\\u00e7\\u00e3o no modo strict.\"),\n\tW041: i18n._(\"Use '{a}' para comparar com '{b}'.\"),\n\tW042: i18n._(\"Evite o escape EOL.\"),\n\tW043: i18n._(\"Escape EOL ruim. Use a op\\u00e7\\u00e3o multistr, se necess\\u00e1rio.\"),\n\tW044: i18n._(\"Escape ruim ou desnecess\\u00e1rio.\"),\n\tW045: i18n._(\"N\\u00famero '{a}' ruim.\"),\n\tW046: i18n._(\"N\\u00e3o use zeros extras \\u00e0 esquerda de \\\"{a}\\\".\"),\n\tW047: i18n._(\"Um ponto \\u00e0 direita do decimal pode ser confundido com um ponto: '{a}'.\"),\n\tW048: i18n._(\"Caractere de controle inesperado na express\\u00e3o regular.\"),\n\tW049: i18n._(\"Caractere de escape inesperado '{a}' na express\\u00e3o regular.\"),\n\tW050: i18n._(\"URL JavaScript.\"),\n\tW051: i18n._(\"Vari\\u00e1veis n\\u00e3o devem ser exclu\\u00eddas.\"),\n\tW052: i18n._(\"'{a}' inesperado.\"),\n\tW053: i18n._(\"N\\u00e3o use {a} como construtor.\"),\n\tW054: i18n._(\"O construtor de fun\\u00e7\\u00e3o \\u00e9 uma forma de avalia\\u00e7\\u00e3o.\"),\n\tW055: i18n._(\"O nome de construtor deve come\\u00e7ar com letra mai\\u00fascula.\"),\n\tW056: i18n._(\"Construtor ruim.\"),\n\tW057: i18n._(\"Constru\\u00e7\\u00e3o estranha. \\u00c9 necess\\u00e1rio usar 'new'?\"),\n\tW058: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um \\\"()\\\" para invocar o construtor.\"),\n\tW059: i18n._(\"Evite argumentos.{a}.\"),\n\tW060: i18n._(\"document.write pode ser uma forma de avalia\\u00e7\\u00e3o.\"),\n\tW061: i18n._(\"o 'eval' pode ser perigoso.\"),\n\tW062: i18n._(\"Coloque uma invoca\\u00e7\\u00e3o de fun\\u00e7\\u00e3o imediata entre par\\u00eanteses para ajudar o leitor a entender que aquela express\\u00e3o \\u00e9 o resultado de uma fun\\u00e7\\u0