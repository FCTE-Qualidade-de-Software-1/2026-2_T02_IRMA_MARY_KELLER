\n\t\t\t\t\t\ttype: token.commentType,\n\t\t\t\t\t\tisSpecial: token.isSpecial,\n\t\t\t\t\t\tline: this.line,\n\t\t\t\t\t\tcharacter: this.char,\n\t\t\t\t\t\tfrom: this.from\n\t\t\t\t\t};\n\t\t\t\t}\n\n\t\t\t\tbreak;\n\n\t\t\tcase \"\":\n\t\t\t\tbreak;\n\n\t\t\tdefault:\n\t\t\t\treturn create(\"(punctuator)\", token.value);\n\t\t\t}\n\t\t}\n\t}\n};\n\nexports.Lexer = Lexer;\n\n},{\"../data/ascii-identifier-data.js\":1,\"../data/non-ascii-identifier-part-only.js\":2,\"../data/non-ascii-identifier-start.js\":3,\"./reg.js\":15,\"./state.js\":16,\"events\":5}],14:[function(require,module,exports){\n\"use strict\";\n\n// XXX(jeresig): Used for i18n string extraction\nvar i18n = { _: function (msg) { return msg; } };\n\nvar errors = {\n\t// JSHint options\n\tE001: i18n._(\"Op\\u00e7\\u00e3o inv\\u00e1lida: '{a}'.\"),\n\tE002: i18n._(\"Valor de op\\u00e7\\u00e3o inv\\u00e1lido.\"),\n\n\t// JSHint input\n\tE003: i18n._(\"Espera-se um valor JSON.\"),\n\tE004: i18n._(\"A entrada n\\u00e3o \\u00e9 nem uma string, nem um array de strings.\"),\n\tE005: i18n._(\"A entrada est\\u00e1 vazia.\"),\n\tE006: i18n._(\"T\\u00e9rmino precoce e inesperado do programa.\"),\n\n\t// Strict mode\n\tE007: i18n._(\"Est\\u00e1 faltando a instru\\u00e7\\u00e3o \\\"use strict\\\".\"),\n\tE008: i18n._(\"Viola\\u00e7\\u00e3o no modo strict.\"),\n\tE009: i18n._(\"A op\\u00e7\\u00e3o 'validthis' n\\u00e3o pode ser usada em um escopo global.\"),\n\tE010: i18n._(\"'with' n\\u00e3o \\u00e9 permitido no modo strict.\"),\n\n\t// Constants\n\tE011: i18n._(\"const '{a}' j\\u00e1 foi declarada.\"),\n\tE012: i18n._(\"const '{a}' \\u00e9 inicializada como 'indefinida'.\"),\n\tE013: i18n._(\"Tentando substituir '{a}' que \\u00e9 uma constante.\"),\n\n\t// Regular expressions\n\tE014: i18n._(\"Uma express\\u00e3o regular literal pode ser confundida com '/='.\"),\n\tE015: i18n._(\"Express\\u00e3o regular n\\u00e3o fechada.\"),\n\tE016: i18n._(\"Express\\u00e3o regular inv\\u00e1lida.\"),\n\n\t// Tokens\n\tE017: i18n._(\"Parece que seu coment\\u00e1rio n\\u00e3o est\\u00e1 encerrado. Use \\\"*/\\\" para finalizar um coment\\u00e1rio de v\\u00e1rias linhas.\"),\n\tE018: i18n._(\"Parece que voc\\u00ea nunca come\\u00e7ou seu coment\\u00e1rio. Use \\\"/*\\\" para iniciar um coment\\u00e1rio de v\\u00e1rias linhas.\"),\n\tE019: i18n._(\"\\\"{a}\\\" n\\u00e3o correspondente.\"),\n\tE020: i18n._(\"Eu pensei que voc\\u00ea ia digitar \\\"{a}\\\" para combinar com \\\"{b}\\\" da linha {c} mas voc\\u00ea digitou \\\"{d}\\\"\"),\n\tE021: i18n._(\"Pensei que voc\\u00ea ia digitar \\\"{a}\\\" mas voc\\u00ea digitou \\\"{b}\\\"!\"),\n\tE022: i18n._(\"Erro '{a}' de quebra de linha.\"),\n\tE023: i18n._(\"Acho que voc\\u00ea se esqueceu de um \\\"{a}\\\"!\"),\n\tE024: i18n._(\"\\\"{a}\\\" inesperado.\"),\n\tE025: i18n._(\"Acho que est\\u00e1 esquecendo um ':' em uma cl\\u00e1usula de case.\"),\n\tE026: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um '}' para combinar com '{' na linha {a}.\"),\n\tE027: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um ']' para combinar com '[' da linha {a}.\"),\n\tE028: i18n._(\"V\\u00edrgula ilegal.\"),\n\tE029: i18n._(\"String n\\u00e3o fechada! Assegure-se de fechar sua string com aspas.\"),\n\n\t// Everything else\n\tE030: i18n._(\"Pensei que voc\\u00ea fosse digitar um identificador, mas voc\\u00ea digitou '{a}'.\"),\n\tE031: i18n._(\"O lado esquerdo de uma atribui\\u00e7\\u00e3o deve ser um nome \\u00fanico de vari\\u00e1vel, e n\\u00e3o uma express\\u00e3o.\"),\n\tE032: i18n._(\"Pensei que voc\\u00ea fosse digitar um n\\u00famero ou 'false', mas voc\\u00ea digitou '{a}'.\"),\n\tE033: i18n._(\"Pensei que voc\\u00ea fosse digitar um operador, mas voc\\u00ea digitou '{a}'.\"),\n\tE034: i18n._(\"get/set s\\u00e3o recursos ES5.\"),\n\tE035: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um nome de propriedade.\"),\n\tE036: i18n._(\"Achei que voc\\u00ea fosse digitar uma condi\\u00e7\\u00e3o, mas, ao inv\\u00e9s disso, voc\\u00ea digitou um bloco.\"),\n\tE037: null,\n\tE038: null,\n\tE039: i18n._(\"Declara\\u00e7\\u00f5es da fun\\u00e7\\u00e3o n\\u00e3o s\\u00e3o invoc\\u00e1veis. Coloque a fun\\u00e7\\u00e3o inteira entre par\\u00eanteses.\"),\n\tE040: i18n._(\"Cada valor deve ter seu pr\\u00f3prio r\\u00f3tulo de case.\"),\n\tE041: i18n._(\"Erro de sintaxe irrecuper\\u00e1vel.\"),\n\tE042: i18n._(\"Parando.\"),\n\tE043: i18n._(\"Muitos erros.\"),\n\tE044: null,\n\tE045: i18n._(\"La\\u00e7o for each inv\\u00e1lido.\"),\n\tE046: i18n._(\"Uma declara\\u00e7\\u00e3o yield deve estar dentro de uma fun\\u00e7\\u00e3o geradora (com sintaxe: `function*`)\"),\n\tE047: i18n._(\"Uma fun\\u00e7\\u00e3o geradora deve conter uma instru\\u00e7\\u00e3o yield.\"),\n\tE048: i18n._(\"N\\u00e3o deixe a declara\\u00e7\\u00e3o diretamente dentro do bloco.\"),\n\tE049: i18n._(\"Um {a} n\\u00e3o pode ser chamado de '{b}'.\"),\n\tE050: i18n._(\"O Mozilla requer que a express\\u00e3o yield esteja entre par\\u00eanteses aqui.\"),\n\tE051: i18n._(\"Par\\u00e2metros regulares n\\u00e3o podem vir depois de par\\u00e2metros padr\\u00e3o.\"),\n\tE052: i18n._(\"Acho que voc\\u00ea quis digitar um valor ou nome de vari\\u00e1vel antes daquela v\\u00edrgula.\"),\n\tE053: i18n._(\"Acho que h\\u00e1 uma v\\u00edrgula extra ou est\\u00e1 faltando um argumento.\")\n};\n\nvar warnings = {\n\tW001: i18n._(\"'hasOwnProperty' \\u00e9 um nome muito ruim.\"),\n\tW002: i18n._(\"O valor de '{a}' pode ser substitu\\u00eddo no IE 8 e em vers\\u00f5es anteriores.\"),\n\tW003: i18n._(\"'{a}' foi usado antes de ser definido.\"),\n\tW004: i18n._(\"'{a}' j\\u00e1 foi definido.\"),\n\tW005: i18n._(\"Um ponto ap\\u00f3s um n\\u00famero pode ser confundido com um ponto decimal.\"),\n\tW006: i18n._(\"Sinais de menos confusos.\"),\n\tW007: i18n._(\"Sinais de mais confusos.\"),\n\tW008: i18n._(\"Coloque um 0 na frente do ponto decimal: \\\"{a}\\\"!\"),\n\tW009: i18n._(\"\\u00c9 prefer\\u00edvel a nota\\u00e7\\u00e3o literal de array [] .\"),\n\tW010: i18n._(\"\\u00c9 prefer\\u00edvel a nota\\u00e7\\u00e3o literal de objeto {} .\"),\n\tW011: i18n._(\"Espa\\u00e7o inesperado ap\\u00f3s '{a}'.\"),\n\tW012: i18n._(\"Espa\\u00e7o inesperado antes de '{a}'.\"),\n\tW013: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um espa\\u00e7o depois do \\\"{a}\\\".\"),\n\tW014: i18n._(\"Quebra de linha ruim antes de '{a}'.\"),\n\tW015: i18n._(\"Espera-se que '{a}' tenha um recuo em {b} e n\\u00e3o em {c}.\"),\n\tW016: i18n._(\"Uso inesperado de '{a}'.\"),\n\tW017: i18n._(\"Operando ruim.\"),\n\tW018: i18n._(\"Uso confuso de '{a}'.\"),\n\tW019: i18n._(\"Use a fun\\u00e7\\u00e3o isNaN para comparar com NaN.\"),\n\tW020: i18n._(\"Somente leitura.\"),\n\tW021: i18n._(\"'{a}' \\u00e9 uma fun\\u00e7\\u00e3o.\"),\n\tW022: i18n._(\"N\\u00e3o atribua ao par\\u00e2metro de exce\\u00e7\\u00e3o.\"),\n\tW023: i18n._(\"Achei que voc\\u00ea fosse digitar um identificador em uma atribui\\u00e7\\u00e3o, mas voc\\u00ea digitou uma invoca\\u00e7\\u00e3o de fun\\u00e7\\u00e3o.\"),\n\tW024: i18n._(\"Achei que voc\\u00ea fosse digitar um identificador, mas voc\\u00ea digitou '{a}' (uma palavra reservada).\"),\n\tW025: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo o nome em sua declara\\u00e7\\u00e3o de fun\\u00e7\\u00e3o.\"),\n\tW026: i18n._(\"Fun\\u00e7\\u00f5es internas devem ser listadas em cima das fun\\u00e7\\u00f5es externas.\"),\n\tW027: i18n._(\"'{a}' inacess\\u00edvel depois de '{b}'.\"),\n\tW028: i18n._(\"R\\u00f3tulo \\\"{a}\\\" na instru\\u00e7\\u00e3o {b}.\"),\n\tW030: i18n._(\"Achei que voc\\u00ea fosse digitar uma atribui\\u00e7\\u00e3o ou chamada de fun\\u00e7\\u00e3o, mas voc\\u00ea digitou uma express\\u00e3o.\"),\n\tW031: i18n._(\"N\\u00e3o use 'new' para efeitos colaterais.\"),\n\tW032: i18n._(\"Parece que voc\\u00ea tem um ponto e v\\u00edrgula desnecess\\u00e1rio.\"),\n\tW033: i18n._(\"Parece que voc\\u00ea est\\u00e1 esquecendo um ponto e v\\u00edrgula.\"),\n\tW034: i18n._(\"Diretiva desnecess\\u00e1ria \\\"{a}\\\".\"),\n\tW035: i18n._(\"Bloco vazio.\"),\n\tW036: i18n._(\"/*membro '{a}' inesperado.\"),\n\tW037: i18n._(\"'{a}' \\u00e9 um r\\u00f3tulo de instru\\u00e7\\u00e3o.\"),\n\tW038: i18n._(\"'{a}' usado fora do escopo.\"),\n\tW039: i18n._(\"'{a}' n\\u00e3o \\u00e9 permitido.\"),\n\tW040: i18n._(\"Poss\\u00edvel viola\\u00e7\\u00e3o no modo strict.\"),\n\tW041: i18n._(\"Use '{a}' para comparar com '{b}'.\"),\n\tW042: i18n._(\"Evite o escape EOL.\"),\n\tW043: i18n._(\"Escape EOL ruim. Use a op\\u00e7\\u00e3o multistr, se necess\\u00e1rio.\"),\n\tW044: i18n._(\"Escape ruim ou desnecess\\u00e1rio.\"),\n\tW045: i18n._(\"N\\u00famero '{a}' ruim.\"),\n\tW046: i18n._(\"N\\u00e3o use zeros extras \\u00e0 esquerda de \\\"{a}\\\".\"),\n\tW047: i18n._(\"Um ponto \\u00e0 direita do decimal pode ser confundido com um ponto: '{a}'.\"),\n\tW048: i18n._(\"Caractere de controle inesperado na express\\u00e3o regular.\"),\n\tW049: i18n._(\"Caractere de escape inesperado '{a}' na express\\u00e3o regular.\"),\n\tW050: i18n._(\"URL JavaScript.\"),\n\tW051: i18n._(\"Vari\\u00e1veis n\\u00e3o devem ser exclu\\u00eddas.\"),\n\tW052: i18n._(\"'{a}' inesperado.\"),\n\tW053: i18n._(\"N\\u00e3o use {a} como construtor.\"),\n\tW054: i18n._(\"O construtor de fun\\u00e7\\u00e3o \\u00e9 uma forma de avalia\\u00e7\\u00e3o.\"),\n\tW055: i18n._(\"O nome de construtor deve come\\u00e7ar com letra mai\\u00fascula.\"),\n\tW056: i18n._(\"Construtor ruim.\"),\n\tW057: i18n._(\"Constru\\u00e7\\u00e3o estranha. \\u00c9 necess\\u00e1rio usar 'new'?\"),\n\tW058: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um \\\"()\\\" para invocar o construtor.\"),\n\tW059: i18n._(\"Evite argumentos.{a}.\"),\n\tW060: i18n._(\"document.write pode ser uma forma de avalia\\u00e7\\u00e3o.\"),\n\tW061: i18n._(\"o 'eval' pode ser perigoso.\"),\n\tW062: i18n._(\"Coloque uma invoca\\u00e7\\u00e3o de fun\\u00e7\\u00e3o imediata entre par\\u00eanteses para ajudar o leitor a entender que aquela express\\u00e3o \\u00e9 o resultado de uma fun\\u00e7\\u0