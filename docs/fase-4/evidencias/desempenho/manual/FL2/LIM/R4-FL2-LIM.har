--trustarc-two-step-overlay-btn-default-hover-color: linear-gradient(360deg,#2025a7 -4.26%,#000579 97.87%);}.trustarc-banner-dpdp-reject-btn {  color: #FFFFFF;  background: linear-gradient(360deg,#000579 -4.26%,#2025a7 97.87%);  border-color: #064676;}.trustarc-banner-dpdp-reject-btn:hover {  background: linear-gradient(360deg,#2025a7 -4.26%,#000579 97.87%);}.trustarc-banner-dpdp-reject-btn:active {  background: #000579;}.trustarc-banner-dpdp-reject-btn-hover {  background: linear-gradient(360deg,#2025a7 -4.26%,#000579 97.87%);}.trustarc-banner-dpdp-reject-btn-active {  background: #000579;}.trustarc-reject-prompt-reject-btn {  color: #FFFFFF;  background: linear-gradient(360deg,#000579 -4.26%,#2025a7 97.87%);  border-color: #000579;}.trustarc-reject-prompt-reject-btn:hover {  background: linear-gradient(360deg,#2025a7 -4.26%,#000579 97.87%);}.trustarc-reject-prompt-reject-btn:active {  background: #000579;}.trustarc-reject-prompt-reject-btn-hover {  background: linear-gradient(360deg,#2025a7 -4.26%,#000579 97.87%);}.trustarc-reject-prompt-reject-btn-active {  background: #000579;}.trustarc-reject-prompt-decline-btn {  color: #FFFFFF;  background: linear-gradient(360deg,#000579 -4.26%,#2025a7 97.87%);  border-color: #000579;}.trustarc-reject-prompt-decline-btn:hover {  background: linear-gradient(360deg,#2025a7 -4.26%,#000579 97.87%);}.trustarc-reject-prompt-decline-btn:active {  background: #000579;}.trustarc-reject-prompt-decline-btn-hover {  background: linear-gradient(360deg,#2025a7 -4.26%,#000579 97.87%);}.trustarc-reject-prompt-decline-btn-active {  background: #000579;}.trustarc-reject-prompt-brand-radius {  border-radius: 40px;}.trustarc-reject-prompt-inner {  font-family: Source Sans Pro;}.trustarc-reject-prompt-header-text {  color: #000000;}.trustarc-reject-prompt-description {  color: #000000;}.trustarc-reject-prompt-overlay-font {  font-family: Source Sans Pro;}.trustarc-reject-prompt-overlay-root {  --trustarc-reject-prompt-overlay-brand-color: #000579;  --trustarc-reject-prompt-overlay-border-radius: 40px;  --trustarc-reject-prompt-overlay-btn-default-color: linear-gradient(360deg,#000579 -4.26%,#2025a7 97.87%);  --trustarc-reject-prompt-overlay-btn-default-hover-color: linear-gradient(360deg,#2025a7 -4.26%,#000579 97.87%);}:root {    --tc-link-color: #5753fa;    --lightBlue: #5753fa;  } \\/* \\u2500\\u2500\\u2500 Banner positioning (unchanged behavior) \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/div#truste-consent-track {    position: fixed;  } \\/* \\u2500\\u2500\\u2500 Base font for banner contents \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/.tc-track > *,.trustarc-banner-actions,#truste-header-text {    font-size: 16px;    font-family: inherit !important;  } \\/* \\u2500\\u2500\\u2500 Banner frame \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/div#truste-consent-content {    position: fixed;    left: 0px;    bottom: 10px;    max-width: 375px;    max-height: 90%;    flex-direction: column;    padding: 24px;    box-sizing: border-box;    transform: translateX(16px);    transition: transform 0.15s ease-in-out;    background: #ffffff;    border: 1px solid #cbcbcd;    border-radius: 8px;    box-shadow: none;  }div#truste-consent-content:focus {    outline-color: #000000;    outline-width: 1px;  } \\/* \\u2500\\u2500\\u2500 Header \\\"Use of cookies\\\" \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/div#truste-header-text h2 {    color: #000000;    font-weight: 600;    font-size: 16px;    line-height: 18px;    margin-bottom: 16px;    font-family: inherit !important;  } \\/* \\u2500\\u2500\\u2500 Body text \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/#truste-consent-text.trustarc-body-text {    color: #000000;    font-size: 12px;    line-height: 16px;    font-weight: 500;    font-family: inherit !important;  } \\/* \\u2500\\u2500\\u2500 Body link \\\"cookie policy\\\" \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/.trustarc-banner-content a {    color: #5753fa;    text-decoration: underline;  }.trustarc-banner-content a:hover {    text-decoration: none;  } \\/* \\u2500\\u2500\\u2500 Button stack \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/.trustarc-banner-actions {    gap: 9px;  } \\/* Shared button properties *\\/.trustarc-banner-actions button {    border: none;    border-radius: 8px;    font-family: inherit !important;    font-size: 16px;    font-weight: 600;    line-height: 18px;    padding: 10px 16px;    letter-spacing: normal;    transition: box-shadow 0.15s ease, color 0.15s ease, background 0.15s ease,    border-radius 0.15s ease;  } \\/* Hide icons + powered-by + close (unchanged behavior) *\\/div#truste-powered-by,.trustarc-banner-actions button i,.trustarc-banner-actions button svg,button#truste-consent-close {    display: none;  } \\/* \\u2500\\u2500\\u2500 Secondary buttons: Accept All Cookies + Strictly Necessary Only *\\/button#truste-consent-button,button#truste-consent-required {    background: #ffffff;    color: #4a4c53;    box-shadow: inset 0 0 0 1px #cbcbcd;  }button#truste-consent-button:hover,button#truste-consent-required:hover {    background: #ffffff;    color: #151521;    box-shadow: inset 0 0 0 2px #4a4c53;  }button#truste-consent-button:active,button#truste-consent-required:active {    background: #ffffff;    color: #151521;    border-radius: 12px;    box-shadow: inset 0 0 0 2px #4a4c53;  }button#truste-consent-button:focus-visible,button#truste-consent-required:focus-visible {    outline: none;    box-shadow: inset 0 0 0 1px #cbcbcd, 0 0 0 2px #ffffff, 0 0 0 4px #5753fa;  } \\/* \\u2500\\u2500\\u2500 Tertiary button: Cookie Settings \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/button#truste-show-consent {    background: transparent;    color: #4a4c53;    box-shadow: none;  }button#truste-show-consent:hover {    background: transparent;    color: #151521;    box-shadow: inset 0 0 0 2px #4a4c53;  }button#truste-show-consent:active {    background: rgba(255, 255, 255, 0.012);    color: #151521;    border-radius: 12px;    box-shadow: inset 0 0 0 2px #4a4c53;  }button#truste-show-consent:focus-visible {    outline: none;    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px #5753fa;  } \\/* \\u2500\\u2500\\u2500 Responsive (kept from prior CSS;                         review if Figma covers responsive) *\\/@media only screen and (min-width: 768px) {    div#truste-consent-content {      width: 48%;    }  .tc-banner-right {      width: 100%;    }}@media only screen and (max-width: 768px) {    div#truste-header-text h2 {      font-size: 16px;    }}@media only screen and (min-width: 426px) and (max-width: 896px) {    div#truste-consent-content {      width: 94%;      max-width: 100%;      left: 0;      bottom: 0;    }}@media only screen and (min-width: 543px) and (max-width: 767px) {    .trustarc-banner-actions.tc-banner-right {      flex-direction: row;      flex-wrap: wrap;    }  .trustarc-banner-actions button {      width: 45%;    }}@media only screen and (max-width: 375px) {    div#truste-consent-content {      transform: translateX(0px);    }}.tc-banner-content a[href],.trustarc-banner-content a {    line-height: inherit;  }.tc-banner-content a[href]:hover,.trustarc-banner-content a:hover {    color: #363498;    text-decoration: none;  }.tc-banner-content a[href]:focus-visible {    box-shadow: 0 0 0 2px #ffffff;    outline: 2px solid #5753fa;    outline-offset: 2px;    border-radius: 4px;  } \\/* \\u2500\\u2500\\u2500 Dark backdrop overlay \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500 *\\/#truste-consent-track:before {    content: \\'\\';    width: 100%;    height: 100%;    background: #000000;    opacity: 0.3;    display: block;    position: fixed;    top: 0;    right: 0;  }</style><div id=\"truste-consent-track\" class=\"tc-track trustarc-banner-wrapper trustarc-banner-background\" role=\"dialog\" aria-modal=\"true\"     aria-label=\"Banner de consentimento de cookies\" aria-labelledby=\"truste-header-text\" aria-describedby=\"truste-consent-text\" style=\"overflow: auto; opacity: 0; display: none;\">  <div class=\"trustarc-banner-content tc-banner-content\" id=\"truste-consent-content\">    <div class=\"tc-banner-wrapper-content\" id=\"truste-wrapper-content\">      <div id=\"trustarc-lang-container\" class=\"languageSelectorContainer trustarc-info-hide\">        <label id=\"trustarc-lang-selector-label\" for=\"trustarc-lang-select\">Selecionar idioma</label>        <select id=\"trustarc-lang-select\" class=\"languageSelectorAccessible\"></select>        <div id=\"trustarc-lang-live-region\" class=\"trustarc-sr-only\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\" lang=\"en\"></div>      </div>      <div class=\"tc-messages\">        <div id=\"trustarc-info\" class=\"trustarc-info-hide\">          <img src=\"https://consent.trustarc.com/v2/asset/ic-exclamation-circle.svg\" alt=\"alert icon\" width=\"14\" height=\"14\" aria-hidden=\"true\"/>          <p id=\"truste-repop-msg\"></p>          <button id=\"truste-repop-msg-close\" class=\"trustarc-close-btn\" aria-label=\"fechar alerta\" type=\"button\">            <img src=\"https://consent.trustarc.com/v2/asset/ic-times.svg\" alt=\"alert message close\" width=\"14\" height=\"14\" aria-hidden=\"true\"/>          </button>        </div>        <div id=\"trustarc-clear-cookie-info\" class=\"trustarc-info-hide\">          <img src=\"https://consent.trustarc.com/v2/asset/ic-exclamation-circle.svg\" alt=\"alert icon\" width=\"14\" height=\"14\" aria-hidden=\"true\"/>          <p id=\"truste-clear-cookie-msg\"></p>          <button id=\"truste-clear-cookie-msg-close\" class=\"trustarc-close-btn\" aria-label=\"fechar alerta\" type=\"button\">            <img src=\"https://consent.trustarc.com/v2/asset/ic-times.svg\" alt=\"alert message close\" width=\"14\" height=\"14\" aria-hidden=\"true\"/>          </button>        </div>      </div>      <div id=\"trustarc-banner-logo-container\" class=\"trustarc-client-logo trustarc-logo-container\">        <img alt=\"Logotipo da empresa\" id=\"truste-banner-logo\" width=\"auto\" height=\"auto\"/>      </div>      <div class=\"tc-banner-left tc-banner-details trustarc-banner-details\">        <div id=\"truste-header-text\" class=\"trustarc-banner-header trustarc-header-text\">          <h2 role=\"heading\" aria-level=\"2\">Use of cookies</h2>        </div>        <div id=\"truste-consent-text\" class=\"trustarc-banner-body trustarc-body-text\">          Este site usa cookies e tecnologias semelhantes, conforme descrito em nossa política de privacidade, para fins que podem incluir operação do site, analítica, experiência do usuário aprimorada e publicidade. Você pode concordar com o uso dessas tecnologias, ou gerenciar suas preferências.        </div>        <div class=\"trustarc-banner-footer-left footer-links-box\" id=\"trustarc-footer-links-container\">          <a class=\"trustarc-banner-left\" id=\"truste-privacy-button\" target=\"_blank\" rel=\"noopener\" aria-label=\"Política de Privacidade\">Política de Privacidade</a>        </div>      </div>    </div>    <div class=\"trustarc-banner-actions tc-banner-right\">      <button          class=\"trustarc-primary-btn trustarc-acceptall-btn trustarc-agree-btn tc-button-icon trustarc-banner-agree-btn trustarc-banner-btn\"          id=\"truste-consent-button\"          type=\"button\">        <i aria-hidden=\"true\" class=\"tc-icon tc-icon-accept\"></i>        <span>Accept All Cookies</span>      </button>      <button          class=\"tc-button-icon trustarc-banner-dpdp-reject-btn trustarc-banner-btn trustarc-primary-btn\"          id=\"truste-consent-reject-all\"          style=\"display:none;opacity:0;\"          type=\"button\">        <i aria-hidden=\"true\" class=\"tc-icon tc-icon-decline\"></i>        <span>Rejeitar todos</span>      </button>      <button          class=\"trustarc-declineall-btn trustarc-reject-btn tc-button-icon trustarc-banner-reject-btn trustarc-banner-btn trustarc-primary-btn\"          id=\"truste-consent-required\"          style=\"display:none;opacity:0;\"          type=\"button\">        <i aria-hidden=\"true\" class=\"tc-icon tc-icon-decline\"></i>        <span>Strictly Necessary Only</span>  