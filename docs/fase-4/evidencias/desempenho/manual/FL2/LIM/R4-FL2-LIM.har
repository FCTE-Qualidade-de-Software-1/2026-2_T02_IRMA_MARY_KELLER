n._(\"Parece que seu coment\\u00e1rio n\\u00e3o est\\u00e1 encerrado. Use \\\"*/\\\" para finalizar um coment\\u00e1rio de v\\u00e1rias linhas.\"),\n\tE018: i18n._(\"Parece que voc\\u00ea nunca come\\u00e7ou seu coment\\u00e1rio. Use \\\"/*\\\" para iniciar um coment\\u00e1rio de v\\u00e1rias linhas.\"),\n\tE019: i18n._(\"\\\"{a}\\\" n\\u00e3o correspondente.\"),\n\tE020: i18n._(\"Eu pensei que voc\\u00ea ia digitar \\\"{a}\\\" para combinar com \\\"{b}\\\" da linha {c} mas voc\\u00ea digitou \\\"{d}\\\"\"),\n\tE021: i18n._(\"Pensei que voc\\u00ea ia digitar \\\"{a}\\\" mas voc\\u00ea digitou \\\"{b}\\\"!\"),\n\tE022: i18n._(\"Erro '{a}' de quebra de linha.\"),\n\tE023: i18n._(\"Acho que voc\\u00ea se esqueceu de um \\\"{a}\\\"!\"),\n\tE024: i18n._(\"\\\"{a}\\\" inesperado.\"),\n\tE025: i18n._(\"Acho que est\\u00e1 esquecendo um ':' em uma cl\\u00e1usula de case.\"),\n\tE026: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um '}' para combinar com '{' na linha {a}.\"),\n\tE027: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um ']' para combinar com '[' da linha {a}.\"),\n\tE028: i18n._(\"V\\u00edrgula ilegal.\"),\n\tE029: i18n._(\"String n\\u00e3o fechada! Assegure-se de fechar sua string com aspas.\"),\n\n\t// Everything else\n\tE030: i18n._(\"Pensei que voc\\u00ea fosse digitar um identificador, mas voc\\u00ea digitou '{a}'.\"),\n\tE031: i18n._(\"O lado esquerdo de uma atribui\\u00e7\\u00e3o deve ser um nome \\u00fanico de vari\\u00e1vel, e n\\u00e3o uma express\\u00e3o.\"),\n\tE032: i18n._(\"Pensei que voc\\u00ea fosse digitar um n\\u00famero ou 'false', mas voc\\u00ea digitou '{a}'.\"),\n\tE033: i18n._(\"Pensei que voc\\u00ea fosse digitar um operador, mas voc\\u00ea digitou '{a}'.\"),\n\tE034: i18n._(\"get/set s\\u00e3o recursos ES5.\"),\n\tE035: i18n._(\"Acho que voc\\u00ea est\\u00e1 esquecendo um nome de propriedade.\"),\n\tE036: i18n._(\"Achei que voc\\u00ea fosse digitar uma condi\\u00e7\\u00e3o, mas, ao inv\\u00e9s disso, voc\\u00ea digitou um bloco.\"),\n\tE037: null,\n\tE038: null,\n\tE039: i18n._(\"Declara\\u00e7\\u00f5es da fun\\u00e7\\u00e3o n\\u00e3o s\\u00e3o invoc\\u00e1veis. Coloque a fun\\u00e7\\u00e3o inteira entre par\\u00eanteses.\"),\n\tE040: i18n._(\"Cada valor deve ter seu pr\\u00f3prio r\\u00f3tulo de case.\"),\n\tE041: i18n._(\"Erro de sintaxe irrecuper\\u00e1vel.\"),\n\tE042: i18n._(\"Parando.\"),\n\tE043: i18n._(\"Muitos erros.\"),\n\tE044: null,\n\tE045: i18n._(\"La\\u00e7o for each inv\\u00e1lido.\"),\n\tE046: i18n._(\"Uma declara\\u00e7\\u00e3o yield deve estar dentro de uma fun\\u00e7\\u00e3o geradora (com sintaxe: `function*`)\"),\n\tE047: i18n._(\"Uma fun\\u00e7\\u00e3o geradora deve conter uma instru\\u00e7\\u00e3o yield.\"),\n\tE048: i18n._(\"N\\u00e3o deixe a declara\\u00e7\\u00e3o diretamente dentro do bloco.\"),\n\tE049: i18n._(\"Um {a} n\\u00e3o pode ser chamado de '{b}'.\"),\n\tE050: i18n._(\"O Mozilla requer que a express\\u00e3o yield esteja entre par\\u00eanteses aqui.\"),\n\tE051: i18n._(\"Par\\u00e2metros regulares n\\u00e3o podem vir depois de par\\u00e2metros padr\\u00e3o.\"),\n\tE052: i18n._(\"Acho que voc\\u00ea quis digitar um valor ou nome de vari\\u00e1vel antes daquela v\\u00edrgula.\"),\n\tE053: i18n._(\"Acho que h\\u00e1 uma v\\u00edrgula extra ou est\\u00e1 faltando um argumento.\")\n};\n\nvar warnings = {\n\tW001: i18n._(\"'hasOwnProperty' \\u00e9 um nome muito ruim.\"),\n\tW002: i18n._(\"O valor de '{a}' pode ser substitu\\u00eddo no IE 8 e em vers\\u00f5es anteriores.\"),\n\tW003: i18n._(\"'{a}' foi usado antes de ser definido.\"),\n\tW004: i18n._(\"'{a}' j\\u00e1 foi definido.\"),\n\tW005: i18n._(\"Um ponto ap\\u00f3s um n\\u00famero pode ser confundido com um ponto decimal.\"),\n\tW006: i18n._(\"Sinais de menos confusos.\"),\n\tW007: i18n._(\"Sinais de mais confusos.\"),\n\tW008: i18n._(\"Coloque um 0 na frente do ponto decimal: \\\"{a}\\\"!\"),\n\tW009: i18n._(\"\\u00c9 prefer\\u00edvel a nota\\u00e7\\u00e3o literal de array [] .\"),\n\tW010: i18n._(\"\\u